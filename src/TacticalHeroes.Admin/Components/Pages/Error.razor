@attribute [Route(AdminRoutes.Error)]
<PageTitle>Ошибка · Tactical Heroes</PageTitle>

<main class="error-page">
    <section>
        <p class="error-code">500</p>
        <h1>Не удалось обработать запрос</h1>
        <p>Повторите попытку или вернитесь на главную страницу.</p>
        @if (ShowRequestId)
        {
            <p class="request-id">
                Идентификатор запроса: <code>@RequestId</code>
            </p>
        }
        <a href="@AdminRoutes.Home">На главную</a>
    </section>
</main>
