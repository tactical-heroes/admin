@page "/Error"
@using System.Diagnostics

<PageTitle>Ошибка · Tactical Heroes</PageTitle>

<main class="error-page">
    <section>
        <p class="error-code">500</p>
        <h1>Не удалось обработать запрос</h1>
        <p>Повторите попытку или вернитесь на главную страницу.</p>
        @if (ShowRequestId)
        {
            <p class="request-id">
                Идентификатор запроса: <code>@RequestId</code>
            </p>
        }
        <a href="/">На главную</a>
    </section>
</main>

<style>
    .error-page {
        display: grid;
        min-height: 100vh;
        place-items: center;
        padding: 2rem;
        background: #f4f6f9;
        color: #1a2230;
        font-family: Inter, "Segoe UI", sans-serif;
        text-align: center;
    }

    .error-code {
        margin: 0;
        color: #d94f3d;
        font-size: 4rem;
        font-weight: 800;
    }

    .error-page h1 {
        margin: 0.5rem 0;
    }

    .request-id {
        color: #667085;
        font-size: 0.8rem;
    }

    .error-page a {
        display: inline-block;
        margin-top: 1rem;
        padding: 0.75rem 1rem;
        border-radius: 8px;
        background: #d94f3d;
        color: #fff;
        font-weight: 700;
        text-decoration: none;
    }
</style>

@code {
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }

    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    protected override void OnInitialized()
    {
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
    }
}
