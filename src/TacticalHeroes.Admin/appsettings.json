{
  "TacticalHeroesApi": {
    "BaseUrl": "https://dev.api.tactical-heroes.panixida.ru",
    "Timeout": "00:00:30"
  },
  "ReverseProxy": {
    "Routes": {
      "tactical-heroes-auth-login": {
        "ClusterId": "tactical-heroes-api",
        "Match": {
          "Path": "/api/v1/auth/login"
        }
      },
      "tactical-heroes-auth-register": {
        "ClusterId": "tactical-heroes-api",
        "Match": {
          "Path": "/api/v1/auth/register"
        }
      },
      "tactical-heroes-auth-confirm-email": {
        "ClusterId": "tactical-heroes-api",
        "Match": {
          "Path": "/api/v1/auth/confirm-email"
        }
      },
      "tactical-heroes-auth-resend-confirmation-email": {
        "ClusterId": "tactical-heroes-api",
        "Match": {
          "Path": "/api/v1/auth/resend-confirmation-email"
        }
      },
      "tactical-heroes-auth-forgot-password": {
        "ClusterId": "tactical-heroes-api",
        "Match": {
          "Path": "/api/v1/auth/forgot-password"
        }
      },
      "tactical-heroes-auth-reset-password": {
        "ClusterId": "tactical-heroes-api",
        "Match": {
          "Path": "/api/v1/auth/reset-password"
        }
      },
      "tactical-heroes-protected-api": {
        "ClusterId": "tactical-heroes-api",
        "AuthorizationPolicy": "TacticalHeroesApiUser",
        "Metadata": {
          "AttachSessionAccessToken": "true"
        },
        "Match": {
          "Path": "/api/{**catch-all}"
        }
      },
      "tactical-heroes-openid-connect": {
        "ClusterId": "tactical-heroes-api",
        "Match": {
          "Path": "/connect/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "tactical-heroes-api": {
        "Destinations": {
          "primary": {
            "Address": "{TacticalHeroesApi:BaseUrl}"
          }
        }
      }
    }
  },
  "Authentication": {
    "OpenIdConnect": {
      "Authority": "https://dev.api.tactical-heroes.panixida.ru",
      "ClientId": "tactical-heroes-web",
      "CallbackPath": "/oauth/callback",
      "SignedOutCallbackPath": "/oauth/logout-callback",
      "RequireHttpsMetadata": true
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
