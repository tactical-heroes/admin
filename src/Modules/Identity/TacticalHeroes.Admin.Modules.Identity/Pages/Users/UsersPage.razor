@page "/users"
@attribute [Authorize]
@attribute [StreamRendering]
@using TacticalHeroes.Admin.Api.Errors
@using TacticalHeroes.Admin.Modules.Identity.Entities.Users.Api
@using TacticalHeroes.Admin.Modules.Identity.Entities.Users.Model
@using TacticalHeroes.Admin.Shared.Model
@inject UsersApi UsersApi

<PageTitle>Пользователи · Tactical Heroes</PageTitle>

<PageHeader Title="Пользователи"
            Subtitle="Управление аккаунтами Tactical Heroes" />

<MudPaper Elevation="0" Class="filter-bar">
    <MudTextField T="string"
                  @bind-Value="_emailFilter"
                  Label="Поиск по email"
                  Placeholder="user@example.com"
                  Variant="Variant.Outlined"
                  Margin="Margin.Dense"
                  Adornment="Adornment.Start"
                  AdornmentIcon="@Icons.Material.Filled.Search"
                  Clearable="true"
                  Disabled="_loading" />
    <div class="filter-actions">
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   Disabled="_loading"
                   OnClick="SearchAsync">
            Найти
        </MudButton>
        <MudIconButton Icon="@Icons.Material.Filled.Refresh"
                       Color="Color.Default"
                       Disabled="_loading"
                       OnClick="RetryAsync"
                       aria-label="Обновить список пользователей" />
    </div>
</MudPaper>

@if (_loading && Page is null)
{
    <MudPaper Elevation="0" Class="table-shell loading-shell">
        <MudSkeleton SkeletonType="SkeletonType.Rectangle"
                     Height="52px"
                     Class="skeleton-row" />
        <MudSkeleton SkeletonType="SkeletonType.Rectangle"
                     Height="52px"
                     Class="skeleton-row" />
        <MudSkeleton SkeletonType="SkeletonType.Rectangle"
                     Height="52px" />
    </MudPaper>
}
else if (!string.IsNullOrWhiteSpace(LoadError))
{
    <MudAlert Severity="Severity.Warning"
              Variant="Variant.Outlined">
        <MudStack Row="true"
                  AlignItems="AlignItems.Center"
                  Justify="Justify.SpaceBetween">
            <span>@LoadError</span>
            <MudButton Variant="Variant.Text"
                       Color="Color.Warning"
                       Disabled="_loading"
                       OnClick="RetryAsync">
                Повторить
            </MudButton>
        </MudStack>
    </MudAlert>
}
else if (Page is not null)
{
    <MudPaper Elevation="0" Class="table-shell">
        <MudTable T="UserSummary"
                  Items="Page.Items"
                  Hover="true"
                  Loading="_loading"
                  Elevation="0">
            <HeaderContent>
                <MudTh>Пользователь</MudTh>
                <MudTh>Email</MudTh>
                <MudTh>Статус</MudTh>
                <MudTh>Подтверждение</MudTh>
                <MudTh Class="actions-column"></MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Пользователь">
                    <MudText Typo="Typo.body2" Class="entity-name">
                        @context.UserName
                    </MudText>
                </MudTd>
                <MudTd DataLabel="Email">@context.Email</MudTd>
                <MudTd DataLabel="Статус">
                    <MudChip T="string"
                             Size="Size.Small"
                             Variant="Variant.Outlined"
                             Color="@GetStatusColor(context.Status)">
                        @context.StatusDisplayName
                    </MudChip>
                </MudTd>
                <MudTd DataLabel="Подтверждение">
                    <MudIcon Icon="@(context.IsConfirmed
                                      ? Icons.Material.Filled.CheckCircle
                                      : Icons.Material.Outlined.Cancel)"
                             Color="@(context.IsConfirmed ? Color.Success : Color.Secondary)"
                             Size="Size.Small" />
                </MudTd>
                <MudTd Class="actions-column">
                    <MudIconButton Icon="@Icons.Material.Outlined.Edit"
                                   Href="@($"/users/{context.Id}")"
                                   Color="Color.Primary"
                                   Size="Size.Small"
                                   aria-label="Редактировать пользователя" />
                </MudTd>
            </RowTemplate>
            <NoRecordsContent>
                <div class="empty-table">Пользователи не найдены</div>
            </NoRecordsContent>
        </MudTable>

        <div class="table-footer">
            <MudText Typo="Typo.caption" Color="Color.Secondary">
                Всего: @Page.TotalCount
            </MudText>
            @if (Page.TotalPages > 1)
            {
                <MudPagination Count="Page.TotalPages"
                               Selected="Page.PageNumber"
                               SelectedChanged="LoadPageAsync"
                               Disabled="_loading"
                               Size="Size.Small" />
            }
        </div>
    </MudPaper>
}

@code {
    private const int PageSize = 10;
    private bool _loading;
    private string? _emailFilter;

    [PersistentState(AllowUpdates = true)]
    public PageResult<UserSummary>? Page { get; set; }

    [PersistentState(AllowUpdates = true)]
    public string? LoadError { get; set; }

    [PersistentState(AllowUpdates = true)]
    public string? AppliedEmailFilter { get; set; }

    protected override async Task OnInitializedAsync()
    {
        _emailFilter = AppliedEmailFilter;

        if (Page is null && LoadError is null)
        {
            await LoadPageAsync(pageNumber: 1);
        }
    }

    private async Task SearchAsync()
    {
        AppliedEmailFilter = string.IsNullOrWhiteSpace(_emailFilter)
            ? null
            : _emailFilter.Trim();
        await LoadPageAsync(pageNumber: 1);
    }

    private async Task RetryAsync()
    {
        await LoadPageAsync(Page?.PageNumber ?? 1);
    }

    private async Task LoadPageAsync(int pageNumber)
    {
        _loading = true;
        LoadError = null;

        try
        {
            Page = await UsersApi.GetPageAsync(
                pageNumber,
                PageSize,
                AppliedEmailFilter);
        }
        catch (Exception exception)
        {
            LoadError = ApiErrorMessage.FromException(exception);
        }
        finally
        {
            _loading = false;
        }
    }

    private static Color GetStatusColor(string status)
    {
        return status.ToLowerInvariant() switch
        {
            "active" => Color.Success,
            "blocked" => Color.Error,
            _ => Color.Default,
        };
    }
}
