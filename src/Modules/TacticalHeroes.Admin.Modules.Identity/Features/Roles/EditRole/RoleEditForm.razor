@using TacticalHeroes.Admin.Modules.Identity.Entities.Claims.Ui
@using TacticalHeroes.Admin.Modules.Identity.Entities.Roles.Model

<MudForm @ref="_form"
         @bind-IsValid="_isValid">
    <EditSection Title="Основные данные">
        <MudTextField T="string"
                      @bind-Value="Model.Name"
                      Label="Название роли"
                      Variant="Variant.Outlined"
                      Error="@HasError(nameof(RoleDetails.Name))"
                      ErrorText="@GetError(nameof(RoleDetails.Name))"
                      Required="true"
                      RequiredError="Укажите название роли"
                      MaxLength="100" />
    </EditSection>

    <EditSection Title="Доступ">
        <ClaimsEditor Claims="Model.Claims" />
    </EditSection>

    <EditFormActions CancelHref="@IdentityRoutes.Roles"
                     IsNew="IsNew"
                     Busy="Busy"
                     OnSubmit="SubmitAsync" />
</MudForm>
