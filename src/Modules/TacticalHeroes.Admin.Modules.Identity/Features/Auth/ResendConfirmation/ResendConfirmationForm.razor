@if (_requested)
{
    <div class="auth-form">
        <header class="auth-form-header">
            <MudIcon Icon="@Icons.Material.Outlined.MarkEmailRead" Class="auth-state-icon" />
            <h1 class="auth-form-title">Проверьте почту</h1>
            <p class="auth-form-copy">
                Если аккаунт существует и ещё не подтверждён, новое письмо уже отправлено.
            </p>
        </header>
        <div class="auth-feedback auth-feedback--success" role="status">
            Если письмо не появилось в течение нескольких минут, проверьте папку «Спам».
        </div>
        <a class="auth-command" href="@LoginHref">Вернуться ко входу</a>
    </div>
}
else
{
    <EditForm Model="_model"
              OnValidSubmit="SubmitAsync"
              FormName="resend-confirmation"
              class="auth-form">
        <DataAnnotationsValidator />

        <header class="auth-form-header">
            <MudIcon Icon="@Icons.Material.Outlined.MarkEmailUnread" Class="auth-state-icon" />
            <h1 class="auth-form-title">Подтверждение email</h1>
            <p class="auth-form-copy">
                Запросите новое письмо, если предыдущая ссылка не пришла или уже истекла.
            </p>
        </header>

        @if (!string.IsNullOrWhiteSpace(_error))
        {
            <div class="auth-feedback auth-feedback--error" role="alert">@_error</div>
        }

        <div class="auth-field">
            <label for="confirmation-email">Email</label>
            <span class="auth-input-shell">
                <MudIcon Icon="@Icons.Material.Outlined.Email" Class="auth-field-icon" />
                <InputText class="auth-input"
                           id="confirmation-email"
                           @bind-Value="_model.Email"
                           type="email"
                           inputmode="email"
                           autocomplete="email"
                           placeholder="Введите email"
                           disabled="@_submitting" />
            </span>
            <ValidationMessage For="@(() => _model.Email)" />
        </div>

        <button type="submit" class="auth-command" disabled="@_submitting">
            @(_submitting ? "Отправляем…" : "Отправить повторно")
        </button>

        <div class="auth-form-footer">
            <p>
                <a class="auth-link" href="@LoginHref">Вернуться ко входу</a>
            </p>
        </div>
    </EditForm>
}
