@using TacticalHeroes.Admin.Modules.Identity.Entities.Claims.Ui
@using TacticalHeroes.Admin.Modules.Identity.Entities.Users.Model

<div class="user-edit-form">
<MudForm @ref="_form"
         @bind-IsValid="_isValid">
    <EditSection Title="Аккаунт">
        <MudGrid Spacing="2">
            <MudItem xs="12" md="6">
                <MudTextField T="string"
                              @bind-Value="Model.Email"
                              Label="Email"
                              InputType="InputType.Email"
                              Variant="Variant.Outlined"
                              Required="true"
                              RequiredError="Укажите email" />
            </MudItem>
            <MudItem xs="12" md="6">
                <MudTextField T="string"
                              @bind-Value="Model.UserName"
                              Label="Имя пользователя"
                              Variant="Variant.Outlined"
                              Required="true"
                              RequiredError="Укажите имя пользователя" />
            </MudItem>
            @if (IsNew)
            {
                <MudItem xs="12" md="6">
                    <MudTextField T="string"
                                  @bind-Value="Model.Password"
                                  Label="Пароль"
                                  InputType="InputType.Password"
                                  Variant="Variant.Outlined"
                                  Required="true"
                                  RequiredError="Укажите пароль" />
                </MudItem>
            }
            <MudItem xs="12" md="6">
                <MudSelect T="string"
                           @bind-Value="Model.Status"
                           ToStringFunc="@GetStatusDisplayName"
                           Label="Статус"
                           Variant="Variant.Outlined"
                           Required="true"
                           RequiredError="Выберите статус">
                    @foreach (var status in Statuses)
                    {
                        <MudSelectItem T="string" Value="@status.Name">
                            @status.DisplayName
                        </MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" md="6" Class="confirmed-field">
                <MudSwitch T="bool"
                           @bind-Value="Model.IsConfirmed"
                           Color="Color.Success"
                           Label="Email подтверждён" />
            </MudItem>
        </MudGrid>
    </EditSection>

    <EditSection Title="Доступ">
        <ClaimsEditor Claims="Model.Claims" />
    </EditSection>

    <EditFormActions CancelHref="@IdentityRoutes.Users"
                     IsNew="IsNew"
                     Busy="Busy"
                     OnSubmit="SubmitAsync" />
</MudForm>
</div>
