@using TacticalHeroes.Admin.Modules.Identity.Entities.Claims.Ui
@using TacticalHeroes.Admin.Modules.Identity.Entities.Users.Model

<MudForm @ref="_form"
         @bind-IsValid="_isValid">
    <MudPaper Elevation="0" Class="edit-section">
        <MudText Typo="Typo.h6" Class="section-title">
            Аккаунт
        </MudText>
        <MudGrid Spacing="2">
            <MudItem xs="12" md="6">
                <MudTextField T="string"
                              @bind-Value="Model.Email"
                              Label="Электронная почта"
                              InputType="InputType.Email"
                              Variant="Variant.Outlined"
                              Required="true"
                              RequiredError="Укажите электронную почту" />
            </MudItem>
            <MudItem xs="12" md="6">
                <MudTextField T="string"
                              @bind-Value="Model.UserName"
                              Label="Имя пользователя"
                              Variant="Variant.Outlined"
                              Required="true"
                              RequiredError="Укажите имя пользователя" />
            </MudItem>
            <MudItem xs="12" md="6">
                <MudSelect T="string"
                           @bind-Value="Model.Status"
                           ToStringFunc="@GetStatusDisplayName"
                           Label="Статус"
                           Variant="Variant.Outlined"
                           Required="true"
                           RequiredError="Выберите статус">
                    @foreach (var status in Statuses)
                    {
                        <MudSelectItem T="string" Value="@status.Name">
                            @status.DisplayName
                        </MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" md="6" Class="confirmed-field">
                <MudSwitch T="bool"
                           @bind-Value="Model.IsConfirmed"
                           Color="Color.Success"
                           Label="Электронная почта подтверждена" />
            </MudItem>
        </MudGrid>
    </MudPaper>

    <MudPaper Elevation="0" Class="edit-section">
        <ClaimsEditor Claims="Model.Claims" />
    </MudPaper>

    <div class="form-actions">
        <MudButton Href="@IdentityRoutes.Users"
                   Variant="Variant.Text"
                   Disabled="Saving">
            Отмена
        </MudButton>
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Save"
                   Disabled="Saving"
                   OnClick="SubmitAsync">
            @if (Saving)
            {
                <MudProgressCircular Size="Size.Small"
                                     Indeterminate="true"
                                     Class="button-progress" />
            }
            Сохранить
        </MudButton>
    </div>
</MudForm>
