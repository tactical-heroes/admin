@inherits CancelableComponentBase
@attribute [Route(IdentityRoutes.CreateUser)]
@attribute [Authorize]
@attribute [StreamRendering]
@using TacticalHeroes.Admin.Modules.Identity.Entities.Claims.Ui
@using TacticalHeroes.Admin.Modules.Identity.Pages.CreateUserPage.Model

<PageTitle>Новый пользователь · Tactical Heroes</PageTitle>

<PageHeader Title="Новый пользователь"
            Subtitle="Создайте аккаунт и настройте доступ пользователя">
    <Actions>
        <MudButton Href="@IdentityRoutes.Users"
                   Variant="Variant.Text"
                   StartIcon="@Icons.Material.Filled.ArrowBack">
            К списку
        </MudButton>
    </Actions>
</PageHeader>

@if (_loading && Statuses is null)
{
    <MudSkeleton SkeletonType="SkeletonType.Rectangle"
                 Height="360px" />
}
else if (!string.IsNullOrWhiteSpace(LoadError))
{
    <MudAlert Severity="Severity.Warning"
              Variant="Variant.Outlined">
        <MudStack Row="true"
                  AlignItems="AlignItems.Center"
                  Justify="Justify.SpaceBetween">
            <span>@LoadError</span>
            <MudButton Variant="Variant.Text"
                       Color="Color.Warning"
                       Disabled="_loading"
                       OnClick="LoadAsync">
                Повторить
            </MudButton>
        </MudStack>
    </MudAlert>
}
else if (Statuses is not null)
{
    <div class="user-edit-form">
        <MudForm @ref="_form"
                 Model="User"
                 Validation="@_validator.ValidateValue"
                 @bind-IsValid="_isValid">
            <EditSection Title="Аккаунт">
                <MudGrid Spacing="2">
                    <MudItem xs="12" md="6">
                        <MudTextField T="string"
                                      @bind-Value="User.Email"
                                      For="@(() => User.Email)"
                                      Label="Email"
                                      InputType="InputType.Email"
                                      Variant="Variant.Outlined"
                                      Error="@_errors.HasError(nameof(CreateUserFormModel.Email))"
                                      ErrorText="@_errors.GetError(nameof(CreateUserFormModel.Email))"
                                      MaxLength="320" />
                    </MudItem>
                    <MudItem xs="12" md="6">
                        <MudTextField T="string"
                                      @bind-Value="User.UserName"
                                      For="@(() => User.UserName)"
                                      Label="Имя пользователя"
                                      Variant="Variant.Outlined"
                                      Error="@_errors.HasError(nameof(CreateUserFormModel.UserName))"
                                      ErrorText="@_errors.GetError(nameof(CreateUserFormModel.UserName))"
                                      MaxLength="256" />
                    </MudItem>
                    <MudItem xs="12" md="6">
                        <MudTextField T="string"
                                      @bind-Value="User.Password"
                                      For="@(() => User.Password)"
                                      Label="Пароль"
                                      InputType="InputType.Password"
                                      Variant="Variant.Outlined"
                                      Error="@_errors.HasError(nameof(CreateUserFormModel.Password))"
                                      ErrorText="@_errors.GetError(nameof(CreateUserFormModel.Password))" />
                    </MudItem>
                    <MudItem xs="12" md="6">
                        <MudSelect T="string"
                                   @bind-Value="User.Status"
                                   For="@(() => User.Status)"
                                   ToStringFunc="@GetStatusDisplayName"
                                   Label="Статус"
                                   Variant="Variant.Outlined"
                                   Error="@_errors.HasError(nameof(CreateUserFormModel.Status))"
                                   ErrorText="@_errors.GetError(nameof(CreateUserFormModel.Status))">
                            @foreach (var status in Statuses)
                            {
                                <MudSelectItem T="string" Value="@status.Name">
                                    @status.DisplayName
                                </MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="12" md="6" Class="confirmed-field">
                        <MudSwitch T="bool"
                                   @bind-Value="User.IsConfirmed"
                                   Color="Color.Success"
                                   Label="Email подтверждён" />
                    </MudItem>
                </MudGrid>
            </EditSection>

            <EditSection Title="Доступ">
                <ClaimsEditor Claims="User.Claims" />
            </EditSection>

            <EditFormActions CancelHref="@IdentityRoutes.Users"
                             IsNew="true"
                             Busy="_saving"
                             OnSubmit="SubmitAsync" />
        </MudForm>
    </div>
}
