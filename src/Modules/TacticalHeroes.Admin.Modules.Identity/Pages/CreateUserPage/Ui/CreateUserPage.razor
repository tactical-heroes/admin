@inherits MudCreateFormComponentBase<CreateUserFormModel, CreateUserFormModelValidator>
@attribute [Route(IdentityRoutes.CreateUser)]
@attribute [Authorize(Policy = Permissions.Users.Create)]
@attribute [StreamRendering]

@using TacticalHeroes.Admin.Modules.Identity.Entities.Claims.Ui
@using TacticalHeroes.Admin.Modules.Identity.Entities.Roles.Ui
@using TacticalHeroes.Admin.Modules.Identity.Entities.Users.Model
@using TacticalHeroes.Admin.Modules.Identity.Pages.CreateUserPage.Model

<PageTitle>Новый пользователь · @(Branding.GameName)</PageTitle>

<PageHeader Title="Новый пользователь"
            Subtitle="Создайте аккаунт и настройте доступ пользователя">
    <Actions>
        <PageBackButton Href="@IdentityRoutes.Users" />
    </Actions>
</PageHeader>

<div class="user-edit-form">
    <MudForm @ref="Form"
             Model="Model"
             Validation="@Validator.ValidateValue"
             @bind-IsValid="IsValid">
        <EditSection Title="Аккаунт">
            <MudGrid Spacing="2">
                <MudItem xs="12" md="6">
                    <MudTextField T="string"
                                  @bind-Value="Model.Email"
                                  For="@(() => Model.Email)"
                                  Label="Email"
                                  InputType="InputType.Email"
                                  Variant="Variant.Outlined"
                                  Error="@Errors.HasError(nameof(CreateUserFormModel.Email))"
                                  ErrorText="@Errors.GetError(nameof(CreateUserFormModel.Email))"
                                  MaxLength="320" />
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudTextField T="string"
                                  @bind-Value="Model.UserName"
                                  For="@(() => Model.UserName)"
                                  Label="Имя пользователя"
                                  Variant="Variant.Outlined"
                                  Error="@Errors.HasError(nameof(CreateUserFormModel.UserName))"
                                  ErrorText="@Errors.GetError(nameof(CreateUserFormModel.UserName))"
                                  MaxLength="256" />
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudTextField T="string"
                                  @bind-Value="Model.Password"
                                  For="@(() => Model.Password)"
                                  Label="Пароль"
                                  InputType="InputType.Password"
                                  Variant="Variant.Outlined"
                                  Error="@Errors.HasError(nameof(CreateUserFormModel.Password))"
                                  ErrorText="@Errors.GetError(nameof(CreateUserFormModel.Password))" />
                </MudItem>
                <MudItem xs="12" md="6">
                    <AsyncEnumerationSelect TEnumeration="UserStatus"
                                            @bind-Value="Model.Status"
                                            For="@(() => Model.Status)"
                                            Label="Статус"
                                            UseFirstAsDefault="true"
                                            Error="@Errors.HasError(nameof(CreateUserFormModel.Status))"
                                            ErrorText="@Errors.GetError(nameof(CreateUserFormModel.Status))" />
                </MudItem>
                <MudItem xs="12" md="6" Class="confirmed-field">
                    <MudSwitch T="bool"
                               @bind-Value="Model.IsConfirmed"
                               Color="Color.Success"
                               Label="Email подтверждён" />
                </MudItem>
            </MudGrid>
        </EditSection>

        <EditSection Title="Доступ">
            <MudStack Spacing="3">
                <RoleMultiSelect @bind-Values="Model.RoleIds"
                                 Error="@Errors.HasError(nameof(CreateUserFormModel.RoleIds))"
                                 ErrorText="@Errors.GetError(nameof(CreateUserFormModel.RoleIds))" />
                <MudText Typo="Typo.caption" Color="Color.Secondary">
                            Личные разрешения дополняют права назначенных ролей.
                            Снятие отметки здесь не отменяет право, полученное через роль.
                        </MudText>
                        <ClaimsEditor Claims="Model.Claims" />
            </MudStack>
        </EditSection>

        <EditFormActions CancelHref="@IdentityRoutes.Users"
                         IsNew="true"
                         Busy="IsSaving"
                         OnSubmit="SubmitAsync" />
    </MudForm>
</div>
