@attribute [Route(IdentityRoutes.Login)]
@layout AccountLayout
@attribute [AllowAnonymous]

@using TacticalHeroes.Admin.Modules.Identity.Widgets.Auth

<PageTitle>@Title</PageTitle>

<AuthenticationShell>
    @switch (SelectedMode)
    {
        case LoginMode.Register:
            <RegisterForm ReturnUrl="@ReturnUrl" />
            break;
        case LoginMode.Confirmation:
            <ResendConfirmationForm ReturnUrl="@ReturnUrl" />
            break;
        case LoginMode.Recover:
            <ForgotPasswordForm ReturnUrl="@ReturnUrl" />
            break;
        default:
            <LoginForm ReturnUrl="@ReturnUrl" Error="@ParsedError" />
            break;
    }
</AuthenticationShell>
