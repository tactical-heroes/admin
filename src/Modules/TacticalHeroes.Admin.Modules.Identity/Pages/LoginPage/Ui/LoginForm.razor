<AuthenticationFeedback Message="@ErrorMessage"
                        Class="auth-feedback--login" />

<div class="auth-form">
    <header class="auth-form-header">
        <MudIcon Icon="@Icons.Material.Outlined.Login" Class="auth-state-icon" />
        <h1 class="auth-form-title">Вход в аккаунт</h1>
        <p class="auth-form-copy">Используйте учётную запись Tactical Heroes.</p>
    </header>

    @if (string.IsNullOrWhiteSpace(ReturnUrl))
    {
        <a class="auth-command"
           href="@IdentityRoutes.Challenge()">
            Продолжить вход
            <span aria-hidden="true">→</span>
        </a>
    }
    else
    {
        <form method="post"
              action="@IdentityRoutes.AuthenticationSignIn"
              class="auth-form">
            <AntiforgeryToken />
            <input type="hidden" name="ReturnUrl" value="@ReturnUrl" />

            <div class="auth-field">
                <label for="login-email">Email</label>
                <span class="auth-input-shell">
                    <MudIcon Icon="@Icons.Material.Outlined.Email" Class="auth-field-icon" />
                    <input class="auth-input"
                           id="login-email"
                           type="email"
                           name="Email"
                           autocomplete="username"
                           inputmode="email"
                           placeholder="Введите email"
                           required />
                </span>
            </div>

            <div class="auth-field">
                <label for="login-password">Пароль</label>
                <span class="auth-input-shell">
                    <MudIcon Icon="@Icons.Material.Outlined.Lock" Class="auth-field-icon" />
                    <input class="auth-input"
                           id="login-password"
                           type="@(_showPassword ? "text" : "password")"
                           name="Password"
                           autocomplete="current-password"
                           placeholder="Введите пароль"
                           required />
                    <button class="auth-password-toggle"
                            type="button"
                            aria-label="@(_showPassword ? "Скрыть пароль" : "Показать пароль")"
                            @onclick="TogglePasswordVisibility">
                        <MudIcon Icon="@(_showPassword ? Icons.Material.Outlined.VisibilityOff : Icons.Material.Outlined.Visibility)" />
                    </button>
                </span>
            </div>

            <div class="auth-option-row">
                <a class="auth-link" href="@BuildModeHref(LoginMode.Recover)">Забыли пароль?</a>
            </div>

            <button type="submit" class="auth-command">
                Войти
                <span aria-hidden="true">→</span>
            </button>
        </form>
    }

    <div class="auth-form-footer">
        <p>
            Нет аккаунта?
            <a class="auth-link" href="@BuildModeHref(LoginMode.Register)">Зарегистрироваться</a>
        </p>
        <p class="auth-form-footer-secondary">
            Не пришло письмо?
            <a class="auth-link" href="@BuildModeHref(LoginMode.Confirmation)">Отправить повторно</a>
        </p>
    </div>
</div>
