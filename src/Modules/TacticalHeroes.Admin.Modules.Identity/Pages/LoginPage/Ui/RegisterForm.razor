@inherits CancelableComponentBase
@using TacticalHeroes.Admin.Modules.Identity.Pages.LoginPage.Model
@if (_registered)
{
    <div class="auth-form">
        <header class="auth-form-header">
            <MudIcon Icon="@Icons.Material.Outlined.MarkEmailRead" Class="auth-state-icon" />
            <h1 class="auth-form-title">Проверьте почту</h1>
            <p class="auth-form-copy">
                Аккаунт создан. Перейдите по ссылке из письма, чтобы подтвердить email.
            </p>
        </header>
        <div class="auth-feedback auth-feedback--success" role="status">
            Если письмо не пришло, запросите его повторно.
        </div>
        <a class="auth-command" href="@ConfirmationHref">Отправить письмо повторно</a>
    </div>
}
else
{
    <MudForm @ref="_form"
             Model="_model"
             Validation="@_validator.ValidateValue"
             @bind-IsValid="_isValid"
             OnEnterPressed="SubmitAsync"
             Class="auth-form">

        <header class="auth-form-header">
            <MudIcon Icon="@Icons.Material.Outlined.PersonAdd" Class="auth-state-icon" />
            <h1 class="auth-form-title">Создать аккаунт</h1>
            <p class="auth-form-copy">Регистрация в Tactical Heroes.</p>
        </header>

        @if (!string.IsNullOrWhiteSpace(_error))
        {
            <div class="auth-feedback auth-feedback--error" role="alert">@_error</div>
        }

        <div class="auth-field">
            <label for="register-email">Email</label>
            <MudTextField T="string"
                          @bind-Value="_model.Email"
                          For="@(() => _model.Email)"
                          InputId="register-email"
                          InputType="InputType.Email"
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Outlined.Email"
                          Variant="Variant.Outlined"
                          Class="auth-text-field"
                          Placeholder="Введите email"
                          Disabled="_submitting"
                          Immediate="true"
                          autocomplete="email" />
        </div>

        <div class="auth-field">
            <label for="register-user-name">Имя пользователя</label>
            <MudTextField T="string"
                          @bind-Value="_model.UserName"
                          For="@(() => _model.UserName)"
                          InputId="register-user-name"
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Outlined.Person"
                          Variant="Variant.Outlined"
                          Class="auth-text-field"
                          Placeholder="Введите имя"
                          Disabled="_submitting"
                          Immediate="true"
                          autocomplete="username" />
        </div>

        <div class="auth-field">
            <label for="register-password">Пароль</label>
            <MudTextField T="string"
                          @bind-Value="_model.Password"
                          For="@(() => _model.Password)"
                          InputId="register-password"
                          InputType="@(_showPassword ? InputType.Text : InputType.Password)"
                          Adornment="Adornment.End"
                          AdornmentIcon="@(_showPassword ? Icons.Material.Outlined.VisibilityOff : Icons.Material.Outlined.Visibility)"
                          AdornmentAriaLabel="@(_showPassword ? "Скрыть пароль" : "Показать пароль")"
                          OnAdornmentClick="TogglePasswordVisibility"
                          Variant="Variant.Outlined"
                          Class="auth-text-field"
                          Placeholder="Введите пароль"
                          Disabled="_submitting"
                          Immediate="true"
                          autocomplete="new-password" />
            <span class="auth-helper">Минимум 8 символов: заглавная и строчная буквы, цифра и специальный символ.</span>
        </div>

        <div class="auth-field">
            <label for="register-password-confirmation">Повторите пароль</label>
            <MudTextField T="string"
                          @bind-Value="_model.PasswordConfirmation"
                          For="@(() => _model.PasswordConfirmation)"
                          InputId="register-password-confirmation"
                          InputType="@(_showPasswordConfirmation ? InputType.Text : InputType.Password)"
                          Adornment="Adornment.End"
                          AdornmentIcon="@(_showPasswordConfirmation ? Icons.Material.Outlined.VisibilityOff : Icons.Material.Outlined.Visibility)"
                          AdornmentAriaLabel="@(_showPasswordConfirmation ? "Скрыть пароль" : "Показать пароль")"
                          OnAdornmentClick="TogglePasswordConfirmationVisibility"
                          Variant="Variant.Outlined"
                          Class="auth-text-field"
                          Placeholder="Повторите пароль"
                          Disabled="_submitting"
                          Immediate="true"
                          autocomplete="new-password" />
        </div>

        <button type="button"
                class="auth-command"
                disabled="@_submitting"
                @onclick="SubmitAsync">
            @(_submitting ? "Создаём аккаунт…" : "Создать аккаунт")
        </button>

        <div class="auth-form-footer">
            <p>
                Уже есть аккаунт?
                <a class="auth-link" href="@LoginHref">Войти</a>
            </p>
        </div>
    </MudForm>
}
