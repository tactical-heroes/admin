@inherits MudValidatedFormComponentBase<EmailModel, EmailModelValidator>
@using TacticalHeroes.Admin.Modules.Identity.Pages.LoginPage.Model
@if (IsSubmitted)
{
    <div class="auth-form">
        <header class="auth-form-header">
            <MudIcon Icon="@Icons.Material.Outlined.Email" Class="auth-state-icon" />
            <h1 class="auth-form-title">Проверьте почту</h1>
            <p class="auth-form-copy">
                Если подтверждённый аккаунт существует, мы отправили ссылку для смены пароля.
            </p>
        </header>
        <div class="auth-feedback auth-feedback--success" role="status">
            Если письмо не появилось в течение нескольких минут, проверьте папку «Спам».
        </div>
        <a class="auth-command" href="@LoginHref">Вернуться ко входу</a>
    </div>
}
else
{
    <MudForm @ref="Form"
             Model="Model"
             Validation="@Validator.ValidateValue"
             OnEnterPressed="SubmitAsync"
             Class="auth-form">

        <header class="auth-form-header">
            <MudIcon Icon="@Icons.Material.Outlined.Key" Class="auth-state-icon" />
            <h1 class="auth-form-title">Восстановление</h1>
            <p class="auth-form-copy">
                Укажите email — мы отправим одноразовую ссылку для смены пароля.
            </p>
        </header>

        @if (!string.IsNullOrWhiteSpace(SubmissionError))
        {
            <div class="auth-feedback auth-feedback--error" role="alert">@SubmissionError</div>
        }

        <div class="auth-field">
            <label for="recovery-email">Email</label>
            <MudTextField T="string"
                          @bind-Value="Model.Email"
                          For="@(() => Model.Email)"
                          InputId="recovery-email"
                          InputType="InputType.Email"
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Outlined.Email"
                          Variant="Variant.Outlined"
                          Class="auth-text-field"
                          Placeholder="Введите email"
                          Disabled="IsSubmitting"
                          Immediate="true"
                          autocomplete="email" />
        </div>

        <button type="button"
                class="auth-command"
                disabled="@IsSubmitting"
                @onclick="SubmitAsync">
            @(IsSubmitting ? "Отправляем…" : "Восстановить доступ")
        </button>

        <div class="auth-form-footer">
            <p>
                Вспомнили пароль?
                <a class="auth-link" href="@LoginHref">Вернуться ко входу</a>
            </p>
        </div>
    </MudForm>
}
