@inherits MudValidatedFormComponentBase<ResetModel, ResetModelValidator>
@attribute [Route(IdentityRoutes.ResetPassword)]
@attribute [AllowAnonymous]
@layout AccountLayout

@using TacticalHeroes.Admin.Modules.Identity.Pages.ResetPasswordPage.Model
@using TacticalHeroes.Admin.Modules.Identity.Widgets.Auth

<PageTitle>Новый пароль · Tactical Heroes</PageTitle>

<AuthenticationShell>
@if (!UserId.HasValue || string.IsNullOrWhiteSpace(PasswordResetToken))
{
    <div class="auth-form">
        <header class="auth-form-header">
            <MudIcon Icon="@Icons.Material.Outlined.LinkOff" Class="auth-state-icon" />
            <h1 class="auth-form-title">Ссылка недействительна</h1>
            <p class="auth-form-copy">Ссылка восстановления неполная или повреждена.</p>
        </header>
        <AuthenticationFeedback Message="Запросите новое письмо для восстановления доступа." />
        <a class="auth-command"
           href="@(IdentityRoutes.LoginPage(mode: LoginMode.Recover))">
            Запросить новую ссылку
        </a>
    </div>
}
else if (IsSubmitted)
{
    <div class="auth-form">
        <header class="auth-form-header">
            <MudIcon Icon="@Icons.Material.Outlined.TaskAlt" Class="auth-state-icon" />
            <h1 class="auth-form-title">Пароль изменён</h1>
            <p class="auth-form-copy">Теперь можно войти с новым паролем.</p>
        </header>
        <AuthenticationFeedback Message="Все активные данные для входа обновлены."
                                Severity="Severity.Success" />
        <a class="auth-command" href="@IdentityRoutes.Challenge()">Перейти ко входу</a>
    </div>
}
else
{
    <MudForm @ref="Form"
             Model="Model"
             Validation="@Validator.ValidateValue"
             OnEnterPressed="SubmitAsync"
             Class="auth-form">

        <header class="auth-form-header">
            <MudIcon Icon="@Icons.Material.Outlined.LockReset" Class="auth-state-icon" />
            <h1 class="auth-form-title">Новый пароль</h1>
            <p class="auth-form-copy">Задайте новый пароль для аккаунта Tactical Heroes.</p>
        </header>

        <AuthenticationFeedback Message="@SubmissionError" />

        <div class="auth-field">
            <label for="reset-password">Новый пароль</label>
            <MudTextField T="string"
                          @bind-Value="Model.Password"
                          For="@(() => Model.Password)"
                          InputId="reset-password"
                          InputType="@(_showPassword ? InputType.Text : InputType.Password)"
                          Adornment="Adornment.End"
                          AdornmentIcon="@(_showPassword ? Icons.Material.Outlined.VisibilityOff : Icons.Material.Outlined.Visibility)"
                          AdornmentAriaLabel="@(_showPassword ? "Скрыть пароль" : "Показать пароль")"
                          OnAdornmentClick="TogglePasswordVisibility"
                          Variant="Variant.Outlined"
                          Class="auth-text-field"
                          Placeholder="Введите новый пароль"
                          Disabled="IsSubmitting"
                          Immediate="true"
                          autocomplete="new-password" />
            <span class="auth-helper">Минимум 8 символов: заглавная и строчная буквы, цифра и специальный символ.</span>
        </div>

        <div class="auth-field">
            <label for="reset-password-confirmation">Повторите пароль</label>
            <MudTextField T="string"
                          @bind-Value="Model.PasswordConfirmation"
                          For="@(() => Model.PasswordConfirmation)"
                          InputId="reset-password-confirmation"
                          InputType="@(_showPasswordConfirmation ? InputType.Text : InputType.Password)"
                          Adornment="Adornment.End"
                          AdornmentIcon="@(_showPasswordConfirmation ? Icons.Material.Outlined.VisibilityOff : Icons.Material.Outlined.Visibility)"
                          AdornmentAriaLabel="@(_showPasswordConfirmation ? "Скрыть пароль" : "Показать пароль")"
                          OnAdornmentClick="TogglePasswordConfirmationVisibility"
                          Variant="Variant.Outlined"
                          Class="auth-text-field"
                          Placeholder="Повторите новый пароль"
                          Disabled="IsSubmitting"
                          Immediate="true"
                          autocomplete="new-password" />
        </div>

        <AsyncActionButton Class="auth-command"
                           Text="Сохранить новый пароль"
                           BusyText="Сохраняем…"
                           Busy="IsSubmitting"
                           ShowProgress="false"
                           OnClick="SubmitAsync" />
    </MudForm>
}
</AuthenticationShell>
