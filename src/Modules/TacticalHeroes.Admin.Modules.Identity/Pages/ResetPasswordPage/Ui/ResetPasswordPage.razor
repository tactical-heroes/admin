@inherits CancelableComponentBase
@attribute [Route(IdentityRoutes.ResetPassword)]
@attribute [AllowAnonymous]
@layout AccountLayout
@using TacticalHeroes.Admin.Modules.Identity.Pages.ResetPasswordPage.Model
@using TacticalHeroes.Admin.Modules.Identity.Widgets.Auth
@using TacticalHeroes.Admin.Shared.Validation

<PageTitle>Новый пароль · Tactical Heroes</PageTitle>

<AuthenticationShell>
@if (!UserId.HasValue || string.IsNullOrWhiteSpace(PasswordResetToken))
{
    <div class="auth-form">
        <header class="auth-form-header">
            <MudIcon Icon="@Icons.Material.Outlined.LinkOff" Class="auth-state-icon" />
            <h1 class="auth-form-title">Ссылка недействительна</h1>
            <p class="auth-form-copy">Ссылка восстановления неполная или повреждена.</p>
        </header>
        <div class="auth-feedback auth-feedback--error" role="alert">
            Запросите новое письмо для восстановления доступа.
        </div>
        <a class="auth-command"
           href="@(IdentityRoutes.LoginPage(mode: LoginMode.Recover))">
            Запросить новую ссылку
        </a>
    </div>
}
else if (_completed)
{
    <div class="auth-form">
        <header class="auth-form-header">
            <MudIcon Icon="@Icons.Material.Outlined.TaskAlt" Class="auth-state-icon" />
            <h1 class="auth-form-title">Пароль изменён</h1>
            <p class="auth-form-copy">Теперь можно войти с новым паролем.</p>
        </header>
        <div class="auth-feedback auth-feedback--success" role="status">
            Все активные данные для входа обновлены.
        </div>
        <a class="auth-command" href="@IdentityRoutes.Challenge()">Перейти ко входу</a>
    </div>
}
else
{
    <EditForm Model="_model"
              OnValidSubmit="SubmitAsync"
              FormName="reset-password"
              class="auth-form">
        <FluentValidationValidator TModel="ResetModel"
                                   Validator="_validator" />

        <header class="auth-form-header">
            <MudIcon Icon="@Icons.Material.Outlined.LockReset" Class="auth-state-icon" />
            <h1 class="auth-form-title">Новый пароль</h1>
            <p class="auth-form-copy">Задайте новый пароль для аккаунта Tactical Heroes.</p>
        </header>

        @if (!string.IsNullOrWhiteSpace(_error))
        {
            <div class="auth-feedback auth-feedback--error" role="alert">@_error</div>
        }

        <div class="auth-field">
            <label for="reset-password">Новый пароль</label>
            <span class="auth-input-shell">
                <MudIcon Icon="@Icons.Material.Outlined.Lock" Class="auth-field-icon" />
                <InputText class="auth-input"
                           id="reset-password"
                           @bind-Value="_model.Password"
                           type="@(_showPassword ? "text" : "password")"
                           autocomplete="new-password"
                           placeholder="Введите новый пароль"
                           disabled="@_submitting" />
                <button class="auth-password-toggle"
                        type="button"
                        aria-label="@(_showPassword ? "Скрыть пароль" : "Показать пароль")"
                        disabled="@_submitting"
                        @onclick="TogglePasswordVisibility">
                    <MudIcon Icon="@(_showPassword ? Icons.Material.Outlined.VisibilityOff : Icons.Material.Outlined.Visibility)" />
                </button>
            </span>
            <ValidationMessage For="@(() => _model.Password)" />
            <span class="auth-helper">Минимум 8 символов: заглавная и строчная буквы, цифра и специальный символ.</span>
        </div>

        <div class="auth-field">
            <label for="reset-password-confirmation">Повторите пароль</label>
            <span class="auth-input-shell">
                <MudIcon Icon="@Icons.Material.Outlined.LockReset" Class="auth-field-icon" />
                <InputText class="auth-input"
                           id="reset-password-confirmation"
                           @bind-Value="_model.PasswordConfirmation"
                           type="@(_showPasswordConfirmation ? "text" : "password")"
                           autocomplete="new-password"
                           placeholder="Повторите новый пароль"
                           disabled="@_submitting" />
                <button class="auth-password-toggle"
                        type="button"
                        aria-label="@(_showPasswordConfirmation ? "Скрыть пароль" : "Показать пароль")"
                        disabled="@_submitting"
                        @onclick="TogglePasswordConfirmationVisibility">
                    <MudIcon Icon="@(_showPasswordConfirmation ? Icons.Material.Outlined.VisibilityOff : Icons.Material.Outlined.Visibility)" />
                </button>
            </span>
            <ValidationMessage For="@(() => _model.PasswordConfirmation)" />
        </div>

        <button type="submit" class="auth-command" disabled="@_submitting">
            @(_submitting ? "Сохраняем…" : "Сохранить новый пароль")
        </button>
    </EditForm>
}
</AuthenticationShell>
