@inherits CancelableComponentBase
@attribute [Route(IdentityRoutes.RoleTemplate)]
@attribute [Authorize]
@attribute [StreamRendering]
@using TacticalHeroes.Admin.Modules.Identity.Entities.Claims.Ui
@using TacticalHeroes.Admin.Modules.Identity.Pages.UpdateRolePage.Model

<PageTitle>Редактирование роли · Tactical Heroes</PageTitle>

<PageHeader Title="Редактирование роли"
            Subtitle="Измените название и атрибуты доступа роли">
    <Actions>
        <MudButton Href="@IdentityRoutes.Roles"
                   Variant="Variant.Text"
                   StartIcon="@Icons.Material.Filled.ArrowBack">
            К списку
        </MudButton>
    </Actions>
</PageHeader>

@if (_loading && Role is null)
{
    <MudSkeleton SkeletonType="SkeletonType.Rectangle"
                 Height="280px" />
}
else if (!string.IsNullOrWhiteSpace(LoadError))
{
    <MudAlert Severity="Severity.Warning"
              Variant="Variant.Outlined">
        <MudStack Row="true"
                  AlignItems="AlignItems.Center"
                  Justify="Justify.SpaceBetween">
            <span>@LoadError</span>
            <MudButton Variant="Variant.Text"
                       Color="Color.Warning"
                       Disabled="_loading"
                       OnClick="LoadAsync">
                Повторить
            </MudButton>
        </MudStack>
    </MudAlert>
}
else if (Role is not null)
{
    <MudForm @ref="_form"
             Model="Role"
             Validation="@_validator.ValidateValue"
             @bind-IsValid="_isValid">
        <EditSection Title="Основные данные">
            <MudTextField T="string"
                          @bind-Value="Role.Name"
                          For="@(() => Role.Name)"
                          Label="Название роли"
                          Variant="Variant.Outlined"
                          Error="@_errors.HasError(nameof(UpdateRoleFormModel.Name))"
                          ErrorText="@_errors.GetError(nameof(UpdateRoleFormModel.Name))"
                          MaxLength="128" />
        </EditSection>

        <EditSection Title="Доступ">
            <ClaimsEditor Claims="Role.Claims" />
        </EditSection>

        <EditFormActions CancelHref="@IdentityRoutes.Roles"
                         Busy="_saving"
                         OnSubmit="SubmitAsync" />
    </MudForm>
}
