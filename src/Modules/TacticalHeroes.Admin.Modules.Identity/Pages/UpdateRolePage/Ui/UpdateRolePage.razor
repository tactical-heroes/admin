@inherits MudUpdateFormComponentBase<UpdateRoleFormModel, UpdateRoleFormModelValidator>
@attribute [Route(IdentityRoutes.RoleTemplate)]
@attribute [Authorize(Policy = IdentityPermissions.Roles.Read)]
@attribute [StreamRendering]

@using TacticalHeroes.Admin.Modules.Identity.Entities.Claims.Ui
@using TacticalHeroes.Admin.Modules.Identity.Pages.UpdateRolePage.Model

<PageTitle>Редактирование роли · @(Branding.GameName)</PageTitle>

<PageHeader Title="Редактирование роли"
            Subtitle="Измените название и атрибуты доступа роли">
    <Actions>
        <PageBackButton Href="@IdentityRoutes.Roles" />
    </Actions>
</PageHeader>

<LoadableContent Loading="IsLoading"
                 LoadError="@LoadError"
                 LoadingHeight="280px"
                 OnRetry="ReloadAsync">
    <ChildContent>
        <MudForm @ref="Form"
                 Model="Model"
                 Validation="@Validator.ValidateValue"
                 @bind-IsValid="IsValid">
            <EditSection Title="Основные данные">
                <MudTextField T="string"
                              @bind-Value="Model.Name"
                              For="@(() => Model.Name)"
                              Label="Название роли"
                              Variant="Variant.Outlined"
                              Error="@Errors.HasError(nameof(UpdateRoleFormModel.Name))"
                              ErrorText="@Errors.GetError(nameof(UpdateRoleFormModel.Name))"
                              MaxLength="128" />
                <MudSwitch T="bool"
                           @bind-Value="Model.IsDefault"
                           Color="Color.Primary"
                           Label="Назначать при регистрации" />
            </EditSection>

            <PermissionView Permissions="[IdentityPermissions.Roles.Update]">
                <EditSection Title="Доступ">
                    <ClaimsEditor Claims="Model.Claims" />
                </EditSection>
            </PermissionView>

            <EditFormActions CancelHref="@IdentityRoutes.Roles"
                             Busy="IsSaving">
                <PermissionView Permissions="[IdentityPermissions.Roles.Update]">
                    <AsyncActionButton Class="submit-action"
                                       Text="Сохранить"
                                       Busy="IsSaving"
                                       StartIcon="@Icons.Material.Filled.Save"
                                       OnClick="SubmitAsync" />
                </PermissionView>
            </EditFormActions>
        </MudForm>
    </ChildContent>
</LoadableContent>
