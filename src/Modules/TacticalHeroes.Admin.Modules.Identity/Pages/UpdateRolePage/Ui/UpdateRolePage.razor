@inherits MudFormComponentBase<UpdateRoleFormModel, UpdateRoleFormModelValidator>
@attribute [Route(IdentityRoutes.RoleTemplate)]
@attribute [Authorize]
@attribute [StreamRendering]
@using TacticalHeroes.Admin.Modules.Identity.Entities.Claims.Ui
@using TacticalHeroes.Admin.Modules.Identity.Pages.UpdateRolePage.Model

<PageTitle>Редактирование роли · Tactical Heroes</PageTitle>

<PageHeader Title="Редактирование роли"
            Subtitle="Измените название и атрибуты доступа роли">
    <Actions>
        <PageBackButton Href="@IdentityRoutes.Roles" />
    </Actions>
</PageHeader>

@if (_loading)
{
    <MudSkeleton SkeletonType="SkeletonType.Rectangle"
                 Height="280px" />
}
else if (!string.IsNullOrWhiteSpace(LoadError))
{
    <MudAlert Severity="Severity.Warning"
              Variant="Variant.Outlined">
        <MudStack Row="true"
                  AlignItems="AlignItems.Center"
                  Justify="Justify.SpaceBetween">
            <span>@LoadError</span>
            <MudButton Variant="Variant.Text"
                       Color="Color.Warning"
                       Disabled="_loading"
                       OnClick="LoadAsync">
                Повторить
            </MudButton>
        </MudStack>
    </MudAlert>
}
else
{
    <MudForm @ref="Form"
             Model="Model"
             Validation="@Validator.ValidateValue"
             @bind-IsValid="IsValid">
        <EditSection Title="Основные данные">
            <MudTextField T="string"
                          @bind-Value="Model.Name"
                          For="@(() => Model.Name)"
                          Label="Название роли"
                          Variant="Variant.Outlined"
                          Error="@Errors.HasError(nameof(UpdateRoleFormModel.Name))"
                          ErrorText="@Errors.GetError(nameof(UpdateRoleFormModel.Name))"
                          MaxLength="128" />
        </EditSection>

        <EditSection Title="Доступ">
            <ClaimsEditor Claims="Model.Claims" />
        </EditSection>

        <EditFormActions CancelHref="@IdentityRoutes.Roles"
                         Busy="IsSaving"
                         OnSubmit="SubmitAsync" />
    </MudForm>
}
