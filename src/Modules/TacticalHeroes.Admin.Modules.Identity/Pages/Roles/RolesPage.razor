@attribute [Route(IdentityRoutes.Roles)]
@attribute [Authorize]
@attribute [StreamRendering]
@using TacticalHeroes.Admin.Modules.Identity.Widgets.Roles.RoleList

<PageTitle>Роли · Tactical Heroes</PageTitle>

<PageHeader Title="Роли"
            Subtitle="Управление ролями и наборами разрешений">
    <Actions>
        <MudButton Href="@IdentityRoutes.CreateRole"
                   Variant="Variant.Filled"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Add">
            Добавить роль
        </MudButton>
    </Actions>
</PageHeader>

<RoleListWidget PageNumber="CurrentPageNumber"
                PageSize="CurrentPageSize"
                PageNumberChanged="ChangePage"
                PageSizeChanged="ChangePageSize" />
