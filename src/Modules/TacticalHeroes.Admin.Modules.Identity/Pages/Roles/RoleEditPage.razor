@attribute [Route(IdentityRoutes.RoleTemplate)]
@attribute [Authorize]
@attribute [StreamRendering]
@using TacticalHeroes.Admin.Api.Errors
@using TacticalHeroes.Admin.Modules.Identity.Entities.Roles.Api
@using TacticalHeroes.Admin.Modules.Identity.Entities.Roles.Model
@using TacticalHeroes.Admin.Modules.Identity.Features.Roles.EditRole
@inject RolesApi RolesApi
@inject ISnackbar Snackbar
@inject NavigationManager Navigation

<PageTitle>Редактирование роли · Tactical Heroes</PageTitle>

<PageHeader Title="Редактирование роли"
            Subtitle="Измените название и claims роли">
    <Actions>
        <MudButton Href="@IdentityRoutes.Roles"
                   Variant="Variant.Text"
                   StartIcon="@Icons.Material.Filled.ArrowBack">
            К списку
        </MudButton>
    </Actions>
</PageHeader>

@if (_loading && Role is null)
{
    <MudSkeleton SkeletonType="SkeletonType.Rectangle"
                 Height="280px" />
}
else if (!string.IsNullOrWhiteSpace(LoadError))
{
    <MudAlert Severity="Severity.Warning"
              Variant="Variant.Outlined">
        <MudStack Row="true"
                  AlignItems="AlignItems.Center"
                  Justify="Justify.SpaceBetween">
            <span>@LoadError</span>
            <MudButton Variant="Variant.Text"
                       Color="Color.Warning"
                       Disabled="_loading"
                       OnClick="LoadAsync">
                Повторить
            </MudButton>
        </MudStack>
    </MudAlert>
}
else if (Role is not null)
{
    <RoleEditForm Model="Role"
                  Saving="_saving"
                  OnSave="SaveAsync" />
}

@code {
    private bool _loading;
    private bool _saving;

    [Parameter]
    public Guid Id { get; set; }

    [PersistentState]
    public RoleDetails? Role { get; set; }

    [PersistentState]
    public string? LoadError { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        if (Role?.Id != Id && LoadError is null)
        {
            await LoadAsync();
        }
    }

    private async Task LoadAsync()
    {
        _loading = true;
        LoadError = null;

        try
        {
            Role = await RolesApi.GetAsync(Id);
        }
        catch (Exception exception)
        {
            LoadError = ApiErrorMessage.FromException(exception);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task SaveAsync()
    {
        if (Role is null)
        {
            return;
        }

        _saving = true;

        try
        {
            await RolesApi.UpdateAsync(Role);
            Snackbar.Add("Роль сохранена", Severity.Success);
            Navigation.NavigateTo(IdentityRoutes.Roles);
        }
        catch (Exception exception)
        {
            Snackbar.Add(ApiErrorMessage.FromException(exception), Severity.Error);
        }
        finally
        {
            _saving = false;
        }
    }
}
