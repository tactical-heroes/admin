@inherits MudPagedListComponentBase<UserListItem, UserListFilter>
@attribute [Route(IdentityRoutes.Users)]
@attribute [Authorize]
@attribute [StreamRendering]

@using TacticalHeroes.Admin.Modules.Identity.Pages.UserListPage.Model

<PageTitle>Пользователи · @(Branding.GameName)</PageTitle>

<PageHeader Title="Пользователи"
            Subtitle="@($"Управление аккаунтами {Branding.GameName}")">
    <Actions>
        <MudButton Href="@IdentityRoutes.CreateUser"
                   Variant="Variant.Filled"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Add">
            Добавить пользователя
        </MudButton>
    </Actions>
</PageHeader>

<EntityList TItem="UserListItem"
            Items="Page?.Items"
            Loading="IsLoading"
            LoadError="@LoadError"
            EmptyText="Пользователи не найдены"
            RefreshLabel="Обновить список пользователей"
            HasFilters="true"
            HasActiveFilters="HasActiveFilter"
            OnApplyFilters="ApplyFilter"
            OnResetFilters="ResetFilter"
            OnRefresh="LoadPageAsync"
            PageNumber="CurrentPageNumber"
            PageSize="CurrentPageSize"
            TotalPages="TotalPages"
            TotalCount="TotalCount"
            OnPageNumberChanged="ChangePage"
            OnPageSizeChanged="ChangePageSize"
            Sorting="AppliedSorting"
            OnSortingChanged="ChangeSorting">
    <Filters>
        <DebouncedTextFilter @bind-Value="FilterDraft.Email"
                             Label="Поиск по Email"
                             Placeholder="user@example.com"
                             MinimumLength="3"
                             OnFilterChanged="ApplyFilter"
                             HelperText="Автоматический запрос выполняется после ввода 3 символов"
                             Disabled="IsLoading" />
    </Filters>
    <Columns>
        <PropertyColumn T="UserListItem" TProperty="string" Property="item => item.UserName" Title="Пользователь">
            <CellTemplate>
                <MudText Typo="Typo.body2" Class="entity-name">
                    @context.Item.UserName
                </MudText>
            </CellTemplate>
        </PropertyColumn>
        <PropertyColumn T="UserListItem" TProperty="string" Property="item => item.Email" Title="Email">
            <CellTemplate>
                @context.Item.Email
            </CellTemplate>
        </PropertyColumn>
        <TemplateColumn T="UserListItem" Title="Статус" Sortable="false">
            <CellTemplate>
                <MudChip T="string"
                         Size="Size.Small"
                         Variant="Variant.Outlined"
                         Color="@context.Item.StatusColor">
                    @context.Item.StatusDisplayName
                </MudChip>
            </CellTemplate>
        </TemplateColumn>
        <PropertyColumn T="UserListItem" TProperty="bool" Property="item => item.IsConfirmed" Title="Подтверждение">
            <CellTemplate>
                <MudIcon Icon="@(context.Item.IsConfirmed
                                  ? Icons.Material.Filled.CheckCircle
                                  : Icons.Material.Outlined.Cancel)"
                         Color="@(context.Item.IsConfirmed ? Color.Success : Color.Secondary)"
                         Size="Size.Small" />
            </CellTemplate>
        </PropertyColumn>
        <TemplateColumn T="UserListItem" Title="Действия" Sortable="false" HeaderClass="actions-column" CellClass="actions-column">
            <CellTemplate>
                <EntityRowActions>
                    <MudIconButton Icon="@Icons.Material.Outlined.Edit"
                                   Href="@IdentityRoutes.User(context.Item.Id)"
                                   Color="Color.Primary"
                                   Size="Size.Small"
                                   Disabled="IsLoading"
                                   aria-label="Редактировать пользователя" />
                    <EntityDeleteButton TKey="Guid"
                                        EntityId="context.Item.Id"
                                        EntityType="пользователя"
                                        EntityName="@context.Item.UserName"
                                        DeleteLabel="Удалить пользователя"
                                        SuccessMessage="Пользователь удалён"
                                        DeleteAsync="DeleteUserAsync"
                                        OnDeleted="OnItemRemovedAsync"
                                        Disabled="IsLoading" />
                </EntityRowActions>
            </CellTemplate>
        </TemplateColumn>
    </Columns>
</EntityList>
