@inherits MudPagedListComponentBase<RoleListItem>
@attribute [Route(IdentityRoutes.Roles)]
@attribute [Authorize]
@attribute [StreamRendering]
@using TacticalHeroes.Admin.Modules.Identity.Pages.RoleListPage.Model

<PageTitle>Роли · Tactical Heroes</PageTitle>

<PageHeader Title="Роли"
            Subtitle="Управление ролями и наборами разрешений">
    <Actions>
        <MudButton Href="@IdentityRoutes.CreateRole"
                   Variant="Variant.Filled"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Add">
            Добавить роль
        </MudButton>
    </Actions>
</PageHeader>

<EntityList TItem="RoleListItem"
            Items="Page?.Items"
            Loading="IsLoading"
            LoadError="@LoadError"
            EmptyText="Роли не найдены"
            RefreshLabel="Обновить список ролей"
            OnRefresh="LoadPageAsync"
            PageNumber="CurrentPageNumber"
            PageSize="CurrentPageSize"
            TotalPages="TotalPages"
            TotalCount="TotalCount"
            OnPageNumberChanged="ChangePage"
            OnPageSizeChanged="ChangePageSize">
    <HeaderContent>
        <MudTh>Название</MudTh>
        <MudTh Class="actions-column">Действия</MudTh>
    </HeaderContent>
    <RowTemplate Context="role">
        <MudTd DataLabel="Название">
            <MudText Typo="Typo.body2" Class="entity-name">
                @role.Name
            </MudText>
        </MudTd>
        <MudTd DataLabel="Действия" Class="actions-column">
            <EntityRowActions>
                <MudIconButton Icon="@Icons.Material.Outlined.Edit"
                               Href="@IdentityRoutes.Role(role.Id)"
                               Color="Color.Primary"
                               Size="Size.Small"
                               Disabled="IsLoading"
                               aria-label="Редактировать роль" />
                <EntityDeleteButton TKey="Guid"
                                    EntityId="role.Id"
                                    EntityType="роль"
                                    EntityName="@role.Name"
                                    DeleteLabel="Удалить роль"
                                    SuccessMessage="Роль удалена"
                                    DeleteAsync="DeleteRoleAsync"
                                    OnDeleted="OnItemRemovedAsync"
                                    Disabled="IsLoading" />
            </EntityRowActions>
        </MudTd>
    </RowTemplate>
</EntityList>
