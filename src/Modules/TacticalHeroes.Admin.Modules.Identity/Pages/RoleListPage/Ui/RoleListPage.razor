@inherits MudPagedListComponentBase<RoleListItem>
@attribute [Route(IdentityRoutes.Roles)]
@attribute [Authorize]
@attribute [StreamRendering]

@using TacticalHeroes.Admin.Modules.Identity.Pages.RoleListPage.Model

<PageTitle>Роли · @(Branding.GameName)</PageTitle>

<PageHeader Title="Роли"
            Subtitle="Управление ролями и наборами разрешений">
    <Actions>
        <MudButton Href="@IdentityRoutes.CreateRole"
                   Variant="Variant.Filled"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Add">
            Добавить роль
        </MudButton>
    </Actions>
</PageHeader>

<EntityList TItem="RoleListItem"
            Items="Page?.Items"
            Loading="IsLoading"
            LoadError="@LoadError"
            EmptyText="Роли не найдены"
            RefreshLabel="Обновить список ролей"
            OnRefresh="LoadPageAsync"
            PageNumber="CurrentPageNumber"
            PageSize="CurrentPageSize"
            TotalPages="TotalPages"
            TotalCount="TotalCount"
            OnPageNumberChanged="ChangePage"
            OnPageSizeChanged="ChangePageSize"
            Sorting="AppliedSorting"
            OnSortingChanged="ChangeSorting">
    <Columns>
        <PropertyColumn T="RoleListItem" TProperty="string" Property="item => item.Name" Title="Название">
            <CellTemplate>
                <MudText Typo="Typo.body2" Class="entity-name">
                    @context.Item.Name
                </MudText>
            </CellTemplate>
        </PropertyColumn>
        <TemplateColumn T="RoleListItem" Title="Действия" Sortable="false" HeaderClass="actions-column" CellClass="actions-column">
            <CellTemplate>
                <EntityRowActions>
                    <MudIconButton Icon="@Icons.Material.Outlined.Edit"
                                   Href="@IdentityRoutes.Role(context.Item.Id)"
                                   Color="Color.Primary"
                                   Size="Size.Small"
                                   Disabled="IsLoading"
                                   aria-label="Редактировать роль" />
                    <EntityDeleteButton TKey="Guid"
                                        EntityId="context.Item.Id"
                                        EntityType="роль"
                                        EntityName="@context.Item.Name"
                                        DeleteLabel="Удалить роль"
                                        SuccessMessage="Роль удалена"
                                        DeleteAsync="DeleteRoleAsync"
                                        OnDeleted="OnItemRemovedAsync"
                                        Disabled="IsLoading" />
                </EntityRowActions>
            </CellTemplate>
        </TemplateColumn>
    </Columns>
</EntityList>
