@using TacticalHeroes.Admin.Modules.Identity.Entities.Roles.Model

<EntityList TItem="RoleSummary"
            Items="Page?.Items"
            Loading="_loading"
            LoadError="LoadError"
            EmptyText="Роли не найдены"
            RefreshLabel="Обновить список ролей"
            OnRefresh="RetryAsync"
            PageNumber="PageNumber"
            PageSize="PageSize"
            TotalPages="@(Page?.TotalPages ?? 0)"
            TotalCount="@(Page?.TotalCount ?? 0)"
            OnPageNumberChanged="ChangePageAsync"
            OnPageSizeChanged="ChangePageSizeAsync">
    <HeaderContent>
        <MudTh>Название</MudTh>
        <MudTh Class="actions-column">Действия</MudTh>
    </HeaderContent>
    <RowTemplate Context="role">
        <MudTd DataLabel="Название">
            <MudText Typo="Typo.body2" Class="entity-name">
                @role.Name
            </MudText>
        </MudTd>
        <MudTd DataLabel="Действия" Class="actions-column">
            <EntityRowActions EditHref="@IdentityRoutes.Role(role.Id)"
                              EditLabel="Редактировать роль"
                              DeleteLabel="Удалить роль"
                              Disabled="@(_loading || _deletingId.HasValue)"
                              OnDelete="@(() => ConfirmDeleteAsync(role))" />
        </MudTd>
    </RowTemplate>
</EntityList>
