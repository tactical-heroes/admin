<section class="auth-shell">
    <span class="auth-shell-corner auth-shell-corner-top-left" aria-hidden="true"></span>
    <span class="auth-shell-corner auth-shell-corner-top-right" aria-hidden="true"></span>
    <span class="auth-shell-corner auth-shell-corner-bottom-right" aria-hidden="true"></span>
    <span class="auth-shell-corner auth-shell-corner-bottom-left" aria-hidden="true"></span>

    <header class="auth-brand">
        <img class="auth-brand-emblem"
             src="auth/tactical-heroes-emblem.png"
             alt="" />
        <div class="auth-brand-title" aria-label="@(Branding.GameName)">
            @foreach (string word in Branding.GameName.Split(' '))
            {
                <span>@word</span>
            }
        </div>
    </header>

    <div class="auth-title-separator" aria-hidden="true"></div>

    <div class="auth-content">
        @ChildContent
    </div>
</section>
