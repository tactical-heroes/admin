@inherits CancelableComponentBase

<LoadableContent Loading="IsLoadingFaction"
                 LoadError="@FactionLoadError"
                 OnRetry="LoadSelectedFactionAsync"
                 LoadingHeight="56px">
    <ChildContent>
        <MudAutocomplete T="Guid"
                         Value="Value"
                         ValueChanged="SetFactionAsync"
                         For="For"
                         Label="Фракция"
                         Variant="Variant.Outlined"
                         ToStringFunc="GetFactionName"
                         SearchFunc="SearchFactionsAsync"
                         DebounceInterval="300"
                         MinCharacters="FactionSearchMinLength"
                         HelperText="Введите минимум 3 символа"
                         MaxItems="FactionOptionLimit"
                         MaxLength="128"
                         Strict="false"
                         Clearable="true"
                         ResetValueOnEmptyText="true"
                         ShowProgressIndicator="true"
                         Error="Error"
                         ErrorText="@ErrorText">
            <NoItemsTemplate>
                @if (FactionSearchError is null)
                {
                    <MudText Class="px-4 py-2">Фракции не найдены.</MudText>
                    <MudLink Href="@CompendiumRoutes.CreateFaction" Class="px-4">Создать фракцию</MudLink>
                }
            </NoItemsTemplate>
        </MudAutocomplete>
        @if (FactionSearchError is not null)
        {
            <MudAlert Severity="Severity.Error" Class="mt-2">@FactionSearchError</MudAlert>
        }
    </ChildContent>
</LoadableContent>
