@inherits MudPagedListComponentBase<FactionListItem>
@attribute [Route(CompendiumRoutes.Factions)]
@attribute [Authorize]
@attribute [StreamRendering]

@using TacticalHeroes.Admin.Modules.Compendium.Pages.FactionListPage.Model

<PageTitle>Фракции · @(Branding.GameName)</PageTitle>

<PageHeader Title="Фракции"
            Subtitle="Управление игровыми фракциями">
    <Actions>
        <MudButton Href="@CompendiumRoutes.CreateFaction"
                   Variant="Variant.Filled"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Add">
            Добавить фракцию
        </MudButton>
    </Actions>
</PageHeader>

<EntityList TItem="FactionListItem"
            Items="Page?.Items"
            Loading="IsLoading"
            LoadError="@LoadError"
            EmptyText="Фракции не найдены"
            RefreshLabel="Обновить список фракций"
            OnRefresh="LoadPageAsync"
            PageNumber="CurrentPageNumber"
            PageSize="CurrentPageSize"
            TotalPages="TotalPages"
            TotalCount="TotalCount"
            OnPageNumberChanged="ChangePage"
            OnPageSizeChanged="ChangePageSize"
            Sorting="AppliedSorting"
            OnSortingChanged="ChangeSorting">
    <Columns>
        <PropertyColumn T="FactionListItem" TProperty="string" Property="item => item.Name" Title="Название">
            <CellTemplate>
                <MudText Typo="Typo.body2" Class="entity-name">
                    @context.Item.Name
                </MudText>
            </CellTemplate>
        </PropertyColumn>
        <PropertyColumn T="FactionListItem" TProperty="string" Property="item => item.Description" Title="Описание">
            <CellTemplate>
                <MudText Typo="Typo.body2" Class="entity-description">
                    @context.Item.Description
                </MudText>
            </CellTemplate>
        </PropertyColumn>
        <TemplateColumn T="FactionListItem" Title="Действия" Sortable="false" HeaderClass="actions-column" CellClass="actions-column">
            <CellTemplate>
                <EntityRowActions>
                    <MudIconButton Icon="@Icons.Material.Outlined.Edit"
                                   Href="@CompendiumRoutes.Faction(context.Item.Id)"
                                   Color="Color.Primary"
                                   Size="Size.Small"
                                   Disabled="IsLoading"
                                   aria-label="Редактировать фракцию" />
                    <EntityDeleteButton TKey="Guid"
                                        EntityId="context.Item.Id"
                                        EntityType="фракцию"
                                        EntityName="@context.Item.Name"
                                        DeleteLabel="Удалить фракцию"
                                        SuccessMessage="Фракция удалена"
                                        DeleteAsync="DeleteFactionAsync"
                                        OnDeleted="OnItemRemovedAsync"
                                        Disabled="IsLoading" />
                </EntityRowActions>
            </CellTemplate>
        </TemplateColumn>
    </Columns>
</EntityList>
