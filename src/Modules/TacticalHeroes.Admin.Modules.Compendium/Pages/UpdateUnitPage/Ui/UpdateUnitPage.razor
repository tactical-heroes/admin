@inherits MudUpdateFormComponentBase<UpdateUnitFormModel, UpdateUnitFormModelValidator>
@attribute [Route(CompendiumRoutes.UnitTemplate)]
@attribute [Authorize]
@attribute [StreamRendering]

@using TacticalHeroes.Admin.Modules.Compendium.Entities.Factions.Ui
@using TacticalHeroes.Admin.Modules.Compendium.Pages.UpdateUnitPage.Model

<PageTitle>Редактирование юнита · @(Branding.GameName)</PageTitle>

<PageHeader Title="Редактирование юнита"
            Subtitle="Измените характеристики и фракцию юнита">
    <Actions>
        <PageBackButton Href="@CompendiumRoutes.Units" />
    </Actions>
</PageHeader>

<LoadableContent Loading="IsLoading"
                 LoadError="@LoadError"
                 OnRetry="ReloadAsync">
    <ChildContent>
        <MudForm @ref="Form"
                 Model="Model"
                 Validation="@Validator.ValidateValue"
                 @bind-IsValid="IsValid">
            <EditSection Title="Данные юнита">
                <MudGrid Spacing="3">
                    <MudItem xs="12" md="6">
                        <MudTextField T="string"
                                      @bind-Value="Model.Name"
                                      For="@(() => Model.Name)"
                                      Label="Имя юнита"
                                      Variant="Variant.Outlined"
                                      Error="@Errors.HasError(nameof(UpdateUnitFormModel.Name))"
                                      ErrorText="@Errors.GetError(nameof(UpdateUnitFormModel.Name))"
                                      MaxLength="128" />
                    </MudItem>
                    <MudItem xs="12" md="6">
                        <FactionSelect @bind-Value="Model.FactionId"
                                       For="@(() => Model.FactionId)"
                                       Error="@Errors.HasError(nameof(UpdateUnitFormModel.FactionId))"
                                       ErrorText="@Errors.GetError(nameof(UpdateUnitFormModel.FactionId))" />
                    </MudItem>
                    <MudItem xs="12">
                        <MudTextField T="string"
                                      @bind-Value="Model.Description"
                                      For="@(() => Model.Description)"
                                      Label="Описание"
                                      Variant="Variant.Outlined"
                                      Error="@Errors.HasError(nameof(UpdateUnitFormModel.Description))"
                                      ErrorText="@Errors.GetError(nameof(UpdateUnitFormModel.Description))"
                                      MaxLength="2000"
                                      Lines="4" />
                    </MudItem>
                    <MudItem xs="12" sm="6" md="4">
                        <MudNumericField T="int"
                                         @bind-Value="Model.Attack"
                                         For="@(() => Model.Attack)"
                                         Label="Атака"
                                         Variant="Variant.Outlined"
                                         Min="0"
                                         Error="@Errors.HasError(nameof(UpdateUnitFormModel.Attack))"
                                         ErrorText="@Errors.GetError(nameof(UpdateUnitFormModel.Attack))" />
                    </MudItem>
                    <MudItem xs="12" sm="6" md="4">
                        <MudNumericField T="int"
                                         @bind-Value="Model.Defense"
                                         For="@(() => Model.Defense)"
                                         Label="Защита"
                                         Variant="Variant.Outlined"
                                         Min="0"
                                         Error="@Errors.HasError(nameof(UpdateUnitFormModel.Defense))"
                                         ErrorText="@Errors.GetError(nameof(UpdateUnitFormModel.Defense))" />
                    </MudItem>
                    <MudItem xs="12" sm="6" md="4">
                        <MudNumericField T="int"
                                         @bind-Value="Model.MinimumDamage"
                                         For="@(() => Model.MinimumDamage)"
                                         Label="Минимальный урон"
                                         Variant="Variant.Outlined"
                                         Min="0"
                                         Error="@Errors.HasError(nameof(UpdateUnitFormModel.MinimumDamage))"
                                         ErrorText="@Errors.GetError(nameof(UpdateUnitFormModel.MinimumDamage))" />
                    </MudItem>
                    <MudItem xs="12" sm="6" md="4">
                        <MudNumericField T="int"
                                         @bind-Value="Model.MaximumDamage"
                                         For="@(() => Model.MaximumDamage)"
                                         Label="Максимальный урон"
                                         Variant="Variant.Outlined"
                                         Min="0"
                                         Error="@Errors.HasError(nameof(UpdateUnitFormModel.MaximumDamage))"
                                         ErrorText="@Errors.GetError(nameof(UpdateUnitFormModel.MaximumDamage))" />
                    </MudItem>
                    <MudItem xs="12" sm="6" md="4">
                        <MudNumericField T="double"
                                         @bind-Value="Model.Initiative"
                                         For="@(() => Model.Initiative)"
                                         Label="Инициатива"
                                         Variant="Variant.Outlined"
                                         Min="0"
                                         Error="@Errors.HasError(nameof(UpdateUnitFormModel.Initiative))"
                                         ErrorText="@Errors.GetError(nameof(UpdateUnitFormModel.Initiative))" />
                    </MudItem>
                    <MudItem xs="12" sm="6" md="4">
                        <MudNumericField T="int"
                                         @bind-Value="Model.Morale"
                                         For="@(() => Model.Morale)"
                                         Label="Мораль"
                                         Variant="Variant.Outlined"
                                         Min="0"
                                         Max="5"
                                         Error="@Errors.HasError(nameof(UpdateUnitFormModel.Morale))"
                                         ErrorText="@Errors.GetError(nameof(UpdateUnitFormModel.Morale))" />
                    </MudItem>
                    <MudItem xs="12" sm="6" md="4">
                        <MudNumericField T="int"
                                         @bind-Value="Model.Luck"
                                         For="@(() => Model.Luck)"
                                         Label="Удача"
                                         Variant="Variant.Outlined"
                                         Min="0"
                                         Max="5"
                                         Error="@Errors.HasError(nameof(UpdateUnitFormModel.Luck))"
                                         ErrorText="@Errors.GetError(nameof(UpdateUnitFormModel.Luck))" />
                    </MudItem>
                    <MudItem xs="12" sm="6" md="4">
                        <MudNumericField T="int"
                                         @bind-Value="Model.Health"
                                         For="@(() => Model.Health)"
                                         Label="Здоровье"
                                         Variant="Variant.Outlined"
                                         Min="1"
                                         Error="@Errors.HasError(nameof(UpdateUnitFormModel.Health))"
                                         ErrorText="@Errors.GetError(nameof(UpdateUnitFormModel.Health))" />
                    </MudItem>
                    <MudItem xs="12" sm="6" md="4">
                        <MudNumericField T="int"
                                         @bind-Value="Model.Speed"
                                         For="@(() => Model.Speed)"
                                         Label="Скорость"
                                         Variant="Variant.Outlined"
                                         Min="0"
                                         Error="@Errors.HasError(nameof(UpdateUnitFormModel.Speed))"
                                         ErrorText="@Errors.GetError(nameof(UpdateUnitFormModel.Speed))" />
                    </MudItem>
                    <MudItem xs="12" sm="6" md="4">
                        <MudNumericField T="int?"
                                         @bind-Value="Model.Shots"
                                         For="@(() => Model.Shots)"
                                         Label="Количество выстрелов"
                                         Variant="Variant.Outlined"
                                         Min="1"
                                         Clearable="true"
                                         HelperText="Для стрелков заполните оба поля стрельбы; для остальных оставьте пустыми"
                                         Error="@Errors.HasError(nameof(UpdateUnitFormModel.Shots))"
                                         ErrorText="@Errors.GetError(nameof(UpdateUnitFormModel.Shots))" />
                    </MudItem>
                    <MudItem xs="12" sm="6" md="4">
                        <MudNumericField T="int?"
                                         @bind-Value="Model.RangedAttackRange"
                                         For="@(() => Model.RangedAttackRange)"
                                         Label="Дальность стрельбы"
                                         Variant="Variant.Outlined"
                                         Min="1"
                                         Clearable="true"
                                         HelperText="Для стрелков заполните оба поля стрельбы; для остальных оставьте пустыми"
                                         Error="@Errors.HasError(nameof(UpdateUnitFormModel.RangedAttackRange))"
                                         ErrorText="@Errors.GetError(nameof(UpdateUnitFormModel.RangedAttackRange))" />
                    </MudItem>
                </MudGrid>
            </EditSection>

            <EditFormActions CancelHref="@CompendiumRoutes.Units"
                             Busy="IsSaving"
                             OnSubmit="SubmitAsync" />
        </MudForm>
    </ChildContent>
</LoadableContent>
