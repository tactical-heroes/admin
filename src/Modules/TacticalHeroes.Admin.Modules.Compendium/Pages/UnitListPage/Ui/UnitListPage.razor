@inherits MudPagedListComponentBase<UnitListItem>
@attribute [Route(CompendiumRoutes.Units)]
@attribute [Authorize]
@attribute [StreamRendering]

@using TacticalHeroes.Admin.Modules.Compendium.Pages.UnitListPage.Model

<PageTitle>Юниты · @(Branding.GameName)</PageTitle>

<PageHeader Title="Юниты"
            Subtitle="Управление игровыми юнитами и их фракциями">
    <Actions>
        <MudButton Href="@CompendiumRoutes.CreateUnit"
                   Variant="Variant.Filled"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Add">
            Добавить юнита
        </MudButton>
    </Actions>
</PageHeader>

<EntityList TItem="UnitListItem"
            Items="Page?.Items"
            Loading="IsLoading"
            LoadError="@LoadError"
            EmptyText="Юниты не найдены"
            RefreshLabel="Обновить список юнитов"
            OnRefresh="LoadPageAsync"
            PageNumber="CurrentPageNumber"
            PageSize="CurrentPageSize"
            TotalPages="TotalPages"
            TotalCount="TotalCount"
            OnPageNumberChanged="ChangePage"
            OnPageSizeChanged="ChangePageSize">
    <HeaderContent>
        <MudTh>Имя</MudTh>
        <MudTh>Фракция</MudTh>
        <MudTh Class="actions-column">Действия</MudTh>
    </HeaderContent>
    <RowTemplate Context="unit">
        <MudTd DataLabel="Имя">
            <MudText Typo="Typo.body2" Class="entity-name">
                @unit.Name
            </MudText>
        </MudTd>
        <MudTd DataLabel="Фракция">
            <MudText Typo="Typo.body2" Class="entity-description">
                @unit.FactionName
            </MudText>
        </MudTd>
        <MudTd DataLabel="Действия" Class="actions-column">
            <EntityRowActions>
                <MudIconButton Icon="@Icons.Material.Outlined.Edit"
                               Href="@CompendiumRoutes.Unit(unit.Id)"
                               Color="Color.Primary"
                               Size="Size.Small"
                               Disabled="IsLoading"
                               aria-label="Редактировать юнита" />
                <EntityDeleteButton TKey="Guid"
                                    EntityId="unit.Id"
                                    EntityType="юнита"
                                    EntityName="@unit.Name"
                                    DeleteLabel="Удалить юнита"
                                    SuccessMessage="Юнит удалён"
                                    DeleteAsync="DeleteUnitAsync"
                                    OnDeleted="OnItemRemovedAsync"
                                    Disabled="IsLoading" />
            </EntityRowActions>
        </MudTd>
    </RowTemplate>
</EntityList>
