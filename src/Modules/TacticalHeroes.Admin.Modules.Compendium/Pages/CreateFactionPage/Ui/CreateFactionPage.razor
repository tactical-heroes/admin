@attribute [Route(CompendiumRoutes.CreateFaction)]
@attribute [Authorize]
@attribute [StreamRendering]
@using TacticalHeroes.Admin.Modules.Compendium.Pages.CreateFactionPage.Model

<PageTitle>Новая фракция · Tactical Heroes</PageTitle>

<PageHeader Title="Новая фракция"
            Subtitle="Добавьте новую игровую фракцию">
    <Actions>
        <MudButton Href="@CompendiumRoutes.Factions"
                   Variant="Variant.Text"
                   StartIcon="@Icons.Material.Filled.ArrowBack">
            К списку
        </MudButton>
    </Actions>
</PageHeader>

<MudForm @ref="_form"
         @bind-IsValid="_isValid">
    <EditSection Title="Основные данные">
        <MudStack Spacing="3">
            <MudTextField T="string"
                          @bind-Value="Faction.Name"
                          Label="Название фракции"
                          Variant="Variant.Outlined"
                          Error="@_fieldErrors.HasError(nameof(CreateFactionFormModel.Name))"
                          ErrorText="@_fieldErrors.GetError(nameof(CreateFactionFormModel.Name))"
                          Required="true"
                          RequiredError="Укажите название фракции"
                          MaxLength="128" />
            <MudTextField T="string"
                          @bind-Value="Faction.Description"
                          Label="Описание"
                          Variant="Variant.Outlined"
                          Error="@_fieldErrors.HasError(nameof(CreateFactionFormModel.Description))"
                          ErrorText="@_fieldErrors.GetError(nameof(CreateFactionFormModel.Description))"
                          Required="true"
                          RequiredError="Укажите описание фракции"
                          MaxLength="2000"
                          Lines="8" />
        </MudStack>
    </EditSection>

    <EditFormActions CancelHref="@CompendiumRoutes.Factions"
                     IsNew="true"
                     Busy="_saving"
                     OnSubmit="SubmitAsync" />
</MudForm>
