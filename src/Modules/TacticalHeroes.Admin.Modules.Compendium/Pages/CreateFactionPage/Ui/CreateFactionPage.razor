@inherits CancelableComponentBase
@attribute [Route(CompendiumRoutes.CreateFaction)]
@attribute [Authorize]
@attribute [StreamRendering]
@using TacticalHeroes.Admin.Modules.Compendium.Pages.CreateFactionPage.Model

<PageTitle>Новая фракция · Tactical Heroes</PageTitle>

<PageHeader Title="Новая фракция"
            Subtitle="Добавьте новую игровую фракцию">
    <Actions>
        <PageBackButton Href="@CompendiumRoutes.Factions" />
    </Actions>
</PageHeader>

<MudForm @ref="_form"
         Model="Faction"
         Validation="@_validator.ValidateValue"
         @bind-IsValid="_isValid">
    <EditSection Title="Основные данные">
        <MudStack Spacing="3">
            <MudTextField T="string"
                          @bind-Value="Faction.Name"
                          For="@(() => Faction.Name)"
                          Label="Название фракции"
                          Variant="Variant.Outlined"
                          Error="@_errors.HasError(nameof(CreateFactionFormModel.Name))"
                          ErrorText="@_errors.GetError(nameof(CreateFactionFormModel.Name))"
                          MaxLength="128" />
            <MudTextField T="string"
                          @bind-Value="Faction.Description"
                          For="@(() => Faction.Description)"
                          Label="Описание"
                          Variant="Variant.Outlined"
                          Error="@_errors.HasError(nameof(CreateFactionFormModel.Description))"
                          ErrorText="@_errors.GetError(nameof(CreateFactionFormModel.Description))"
                          MaxLength="2000"
                          Lines="8" />
        </MudStack>
    </EditSection>

    <EditFormActions CancelHref="@CompendiumRoutes.Factions"
                     IsNew="true"
                     Busy="_saving"
                     OnSubmit="SubmitAsync" />
</MudForm>
