@inherits CancelableComponentBase
@attribute [Route(CompendiumRoutes.FactionTemplate)]
@attribute [Authorize]
@attribute [StreamRendering]
@using TacticalHeroes.Admin.Modules.Compendium.Pages.UpdateFactionPage.Model

<PageTitle>Редактирование фракции · Tactical Heroes</PageTitle>

<PageHeader Title="Редактирование фракции"
            Subtitle="Измените название и описание фракции">
    <Actions>
        <PageBackButton Href="@CompendiumRoutes.Factions" />
    </Actions>
</PageHeader>

@if (_loading && Faction is null)
{
    <MudSkeleton SkeletonType="SkeletonType.Rectangle"
                 Height="360px" />
}
else if (!string.IsNullOrWhiteSpace(LoadError))
{
    <MudAlert Severity="Severity.Warning"
              Variant="Variant.Outlined">
        <MudStack Row="true"
                  AlignItems="AlignItems.Center"
                  Justify="Justify.SpaceBetween">
            <span>@LoadError</span>
            <MudButton Variant="Variant.Text"
                       Color="Color.Warning"
                       Disabled="_loading"
                       OnClick="LoadAsync">
                Повторить
            </MudButton>
        </MudStack>
    </MudAlert>
}
else if (Faction is not null)
{
    <MudForm @ref="_form"
             Model="Faction"
             Validation="@_validator.ValidateValue"
             @bind-IsValid="_isValid">
        <EditSection Title="Основные данные">
            <MudStack Spacing="3">
                <MudTextField T="string"
                              @bind-Value="Faction.Name"
                              For="@(() => Faction.Name)"
                              Label="Название фракции"
                              Variant="Variant.Outlined"
                              Error="@_errors.HasError(nameof(UpdateFactionFormModel.Name))"
                              ErrorText="@_errors.GetError(nameof(UpdateFactionFormModel.Name))"
                              MaxLength="128" />
                <MudTextField T="string"
                              @bind-Value="Faction.Description"
                              For="@(() => Faction.Description)"
                              Label="Описание"
                              Variant="Variant.Outlined"
                              Error="@_errors.HasError(nameof(UpdateFactionFormModel.Description))"
                              ErrorText="@_errors.GetError(nameof(UpdateFactionFormModel.Description))"
                              MaxLength="2000"
                              Lines="8" />
            </MudStack>
        </EditSection>

        <EditFormActions CancelHref="@CompendiumRoutes.Factions"
                         Busy="_saving"
                         OnSubmit="SubmitAsync" />
    </MudForm>
}
