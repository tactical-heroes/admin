@inherits MudUpdateFormComponentBase<UpdateFactionFormModel, UpdateFactionFormModelValidator>
@attribute [Route(CompendiumRoutes.FactionTemplate)]
@attribute [Authorize]
@attribute [StreamRendering]

@using TacticalHeroes.Admin.Modules.Compendium.Pages.UpdateFactionPage.Model

<PageTitle>Редактирование фракции · Tactical Heroes</PageTitle>

<PageHeader Title="Редактирование фракции"
            Subtitle="Измените название и описание фракции">
    <Actions>
        <PageBackButton Href="@CompendiumRoutes.Factions" />
    </Actions>
</PageHeader>

<LoadableContent Loading="IsLoading"
                 LoadError="@LoadError"
                 OnRetry="ReloadAsync">
    <ChildContent>
        <MudForm @ref="Form"
                 Model="Model"
                 Validation="@Validator.ValidateValue"
                 @bind-IsValid="IsValid">
            <EditSection Title="Основные данные">
                <MudStack Spacing="3">
                    <MudTextField T="string"
                                  @bind-Value="Model.Name"
                                  For="@(() => Model.Name)"
                                  Label="Название фракции"
                                  Variant="Variant.Outlined"
                                  Error="@Errors.HasError(nameof(UpdateFactionFormModel.Name))"
                                  ErrorText="@Errors.GetError(nameof(UpdateFactionFormModel.Name))"
                                  MaxLength="128" />
                    <MudTextField T="string"
                                  @bind-Value="Model.Description"
                                  For="@(() => Model.Description)"
                                  Label="Описание"
                                  Variant="Variant.Outlined"
                                  Error="@Errors.HasError(nameof(UpdateFactionFormModel.Description))"
                                  ErrorText="@Errors.GetError(nameof(UpdateFactionFormModel.Description))"
                                  MaxLength="2000"
                                  Lines="8" />
                </MudStack>
            </EditSection>

            <EditFormActions CancelHref="@CompendiumRoutes.Factions"
                             Busy="IsSaving"
                             OnSubmit="SubmitAsync" />
        </MudForm>
    </ChildContent>
</LoadableContent>
