@attribute [Route(CompendiumRoutes.Factions)]
@attribute [Authorize]
@attribute [StreamRendering]
@using TacticalHeroes.Admin.Modules.Compendium.Widgets.Factions.FactionList

<PageTitle>Фракции · Tactical Heroes</PageTitle>

<PageHeader Title="Фракции"
            Subtitle="Управление игровыми фракциями Compendium">
    <Actions>
        <MudButton Href="@CompendiumRoutes.CreateFaction"
                   Variant="Variant.Filled"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Add">
            Добавить фракцию
        </MudButton>
    </Actions>
</PageHeader>

<FactionListWidget PageNumber="CurrentPageNumber"
                   PageNumberChanged="ChangePage" />
