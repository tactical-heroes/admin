@using TacticalHeroes.Admin.Modules.Compendium.Entities.Factions.Model

<MudForm @ref="_form"
         @bind-IsValid="_isValid">
    <EditSection Title="Основные данные">
        <MudStack Spacing="3">
            <MudTextField T="string"
                          @bind-Value="Model.Name"
                          Label="Название фракции"
                          Variant="Variant.Outlined"
                          Required="true"
                          RequiredError="Укажите название фракции"
                          MaxLength="128" />
            <MudTextField T="string"
                          @bind-Value="Model.Description"
                          Label="Описание"
                          Variant="Variant.Outlined"
                          Required="true"
                          RequiredError="Укажите описание фракции"
                          MaxLength="2000"
                          Lines="8" />
        </MudStack>
    </EditSection>

    <EditFormActions CancelHref="@CompendiumRoutes.Factions"
                     IsNew="IsNew"
                     Busy="Busy"
                     OnSubmit="SubmitAsync" />
</MudForm>
