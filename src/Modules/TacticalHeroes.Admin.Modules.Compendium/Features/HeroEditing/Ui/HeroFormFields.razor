@inherits CancelableComponentBase

@using TacticalHeroes.Admin.Modules.Compendium.Features.HeroEditing.Model

<MudGrid Spacing="3">
    <MudItem xs="12" md="6">
        <MudTextField T="string"
                      @bind-Value="Model.Name"
                      For="@(() => Model.Name)"
                      Label="Имя героя"
                      Variant="Variant.Outlined"
                      Error="@Errors.HasError(nameof(HeroFormModel.Name))"
                      ErrorText="@Errors.GetError(nameof(HeroFormModel.Name))"
                      MaxLength="128" />
    </MudItem>
    <MudItem xs="12" md="6">
        <LoadableContent Loading="IsLoadingFaction"
                         LoadError="@FactionLoadError"
                         OnRetry="LoadSelectedFactionAsync"
                         LoadingHeight="56px">
            <ChildContent>
                <MudAutocomplete T="Guid"
                                 Value="Model.FactionId"
                                 ValueChanged="SetFaction"
                                 For="@(() => Model.FactionId)"
                                 Label="Фракция"
                                 Variant="Variant.Outlined"
                                 ToStringFunc="GetFactionName"
                                 SearchFunc="SearchFactionsAsync"
                                 DebounceInterval="300"
                                 MaxItems="FactionOptionLimit"
                                 MaxLength="128"
                                 Strict="false"
                                 Clearable="true"
                                 ResetValueOnEmptyText="true"
                                 ShowProgressIndicator="true"
                                 Error="@Errors.HasError(nameof(HeroFormModel.FactionId))"
                                 ErrorText="@Errors.GetError(nameof(HeroFormModel.FactionId))">
                    <NoItemsTemplate>
                        @if (FactionSearchError is null)
                        {
                            <MudText Class="px-4 py-2">Фракции не найдены.</MudText>
                            <MudLink Href="@CompendiumRoutes.CreateFaction" Class="px-4">Создать фракцию</MudLink>
                        }
                    </NoItemsTemplate>
                </MudAutocomplete>
                @if (FactionSearchError is not null)
                {
                    <MudAlert Severity="Severity.Error" Class="mt-2">@FactionSearchError</MudAlert>
                }
            </ChildContent>
        </LoadableContent>
    </MudItem>
    <MudItem xs="12">
        <MudTextField T="string"
                      @bind-Value="Model.Description"
                      For="@(() => Model.Description)"
                      Label="Описание"
                      Variant="Variant.Outlined"
                      Error="@Errors.HasError(nameof(HeroFormModel.Description))"
                      ErrorText="@Errors.GetError(nameof(HeroFormModel.Description))"
                      MaxLength="2000"
                      Lines="4" />
    </MudItem>
    <MudItem xs="12" sm="6" md="4">
        <MudNumericField T="int"
                         @bind-Value="Model.Attack"
                         For="@(() => Model.Attack)"
                         Label="Атака"
                         Variant="Variant.Outlined"
                         Min="0"
                         Error="@Errors.HasError(nameof(HeroFormModel.Attack))"
                         ErrorText="@Errors.GetError(nameof(HeroFormModel.Attack))" />
    </MudItem>
    <MudItem xs="12" sm="6" md="4">
        <MudNumericField T="int"
                         @bind-Value="Model.Defense"
                         For="@(() => Model.Defense)"
                         Label="Защита"
                         Variant="Variant.Outlined"
                         Min="0"
                         Error="@Errors.HasError(nameof(HeroFormModel.Defense))"
                         ErrorText="@Errors.GetError(nameof(HeroFormModel.Defense))" />
    </MudItem>
    <MudItem xs="12" sm="6" md="4">
        <MudNumericField T="int"
                         @bind-Value="Model.MinimumDamage"
                         For="@(() => Model.MinimumDamage)"
                         Label="Минимальный урон"
                         Variant="Variant.Outlined"
                         Min="0"
                         Error="@Errors.HasError(nameof(HeroFormModel.MinimumDamage))"
                         ErrorText="@Errors.GetError(nameof(HeroFormModel.MinimumDamage))" />
    </MudItem>
    <MudItem xs="12" sm="6" md="4">
        <MudNumericField T="int"
                         @bind-Value="Model.MaximumDamage"
                         For="@(() => Model.MaximumDamage)"
                         Label="Максимальный урон"
                         Variant="Variant.Outlined"
                         Min="0"
                         Error="@Errors.HasError(nameof(HeroFormModel.MaximumDamage))"
                         ErrorText="@Errors.GetError(nameof(HeroFormModel.MaximumDamage))" />
    </MudItem>
    <MudItem xs="12" sm="6" md="4">
        <MudNumericField T="double"
                         @bind-Value="Model.Initiative"
                         For="@(() => Model.Initiative)"
                         Label="Инициатива"
                         Variant="Variant.Outlined"
                         Min="0"
                         Error="@Errors.HasError(nameof(HeroFormModel.Initiative))"
                         ErrorText="@Errors.GetError(nameof(HeroFormModel.Initiative))" />
    </MudItem>
    <MudItem xs="12" sm="6" md="4">
        <MudNumericField T="int"
                         @bind-Value="Model.Morale"
                         For="@(() => Model.Morale)"
                         Label="Мораль"
                         Variant="Variant.Outlined"
                         Min="0"
                         Max="5"
                         Error="@Errors.HasError(nameof(HeroFormModel.Morale))"
                         ErrorText="@Errors.GetError(nameof(HeroFormModel.Morale))" />
    </MudItem>
    <MudItem xs="12" sm="6" md="4">
        <MudNumericField T="int"
                         @bind-Value="Model.Luck"
                         For="@(() => Model.Luck)"
                         Label="Удача"
                         Variant="Variant.Outlined"
                         Min="0"
                         Max="5"
                         Error="@Errors.HasError(nameof(HeroFormModel.Luck))"
                         ErrorText="@Errors.GetError(nameof(HeroFormModel.Luck))" />
    </MudItem>
</MudGrid>
