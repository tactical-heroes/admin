@using TacticalHeroes.Admin.Modules.Compendium.Entities.Factions.Model

<EntityList TItem="FactionListItem"
            Items="Page?.Items"
            Loading="_loading"
            LoadError="@LoadError"
            EmptyText="Фракции не найдены"
            RefreshLabel="Обновить список фракций"
            OnRefresh="RetryAsync"
            PageNumber="PageNumber"
            PageSize="PageSize"
            TotalPages="@(Page?.TotalPages ?? 0)"
            TotalCount="@(Page?.TotalCount ?? 0)"
            OnPageNumberChanged="ChangePageAsync"
            OnPageSizeChanged="ChangePageSizeAsync">
    <HeaderContent>
        <MudTh>Название</MudTh>
        <MudTh>Описание</MudTh>
        <MudTh Class="actions-column">Действия</MudTh>
    </HeaderContent>
    <RowTemplate Context="faction">
        <MudTd DataLabel="Название">
            <MudText Typo="Typo.body2" Class="entity-name">
                @faction.Name
            </MudText>
        </MudTd>
        <MudTd DataLabel="Описание">
            <MudText Typo="Typo.body2" Class="entity-description">
                @faction.Description
            </MudText>
        </MudTd>
        <MudTd DataLabel="Действия" Class="actions-column">
            <EntityRowActions EditHref="@CompendiumRoutes.Faction(faction.Id)"
                              EditLabel="Редактировать фракцию"
                              DeleteLabel="Удалить фракцию"
                              Disabled="@(_loading || _deletingId.HasValue)"
                              OnDelete="@(() => ConfirmDeleteAsync(faction))" />
        </MudTd>
    </RowTemplate>
</EntityList>
