@page "/reset-password"
@layout AccountLayout
@attribute [AllowAnonymous]
@using TacticalHeroes.Admin.Client.Features.Authentication.ResetPassword

<PageTitle>Новый пароль · Tactical Heroes</PageTitle>

<MudPaper Elevation="0" Class="reset-panel">
    <MudText Typo="Typo.overline" Color="Color.Primary">ACCOUNT RECOVERY</MudText>
    <MudText Typo="Typo.h4" Class="reset-title">Новый пароль</MudText>
    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="reset-copy">
        Ссылка содержит одноразовый токен. После успешного сброса используйте новый пароль для входа.
    </MudText>

    <ResetPasswordForm UserId="@UserId" PasswordResetToken="@PasswordResetToken" />
</MudPaper>

@code {
    [SupplyParameterFromQuery(Name = "userId")]
    public Guid? UserId { get; set; }

    [SupplyParameterFromQuery(Name = "passwordResetToken")]
    public string? PasswordResetToken { get; set; }
}
