@page "/login"
@layout AccountLayout
@attribute [AllowAnonymous]
@using TacticalHeroes.Admin.Client.Features.Authentication.ForgotPassword
@using TacticalHeroes.Admin.Client.Features.Authentication.Login
@using TacticalHeroes.Admin.Client.Features.Authentication.Register
@using TacticalHeroes.Admin.Client.Features.Authentication.ResendConfirmation

<PageTitle>@Title</PageTitle>

<AuthenticationShell ActiveView="@ActiveView" ReturnUrl="@ReturnUrl">
    @switch (ActiveView)
    {
        case AuthenticationView.Register:
            <RegisterForm />
            break;
        case AuthenticationView.Confirmation:
            <ResendConfirmationForm />
            break;
        case AuthenticationView.Recovery:
            <ForgotPasswordForm />
            break;
        default:
            <LoginForm ReturnUrl="@ReturnUrl" Error="@Error" />
            break;
    }
</AuthenticationShell>

@code {
    [SupplyParameterFromQuery(Name = "returnUrl")]
    public string? ReturnUrl { get; set; }

    [SupplyParameterFromQuery(Name = "error")]
    public string? Error { get; set; }

    [SupplyParameterFromQuery(Name = "mode")]
    public string? Mode { get; set; }

    private AuthenticationView ActiveView => Mode?.ToLowerInvariant() switch
    {
        "register" => AuthenticationView.Register,
        "confirmation" => AuthenticationView.Confirmation,
        "recover" => AuthenticationView.Recovery,
        _ => AuthenticationView.Login,
    };

    private string Title => ActiveView switch
    {
        AuthenticationView.Register => "Регистрация · Tactical Heroes",
        AuthenticationView.Confirmation => "Подтверждение email · Tactical Heroes",
        AuthenticationView.Recovery => "Восстановление доступа · Tactical Heroes",
        _ => "Вход · Tactical Heroes",
    };
}
