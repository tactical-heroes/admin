@page "/login"
@layout AccountLayout
@attribute [AllowAnonymous]
@using TacticalHeroes.Admin.Client.Features.Authentication.ForgotPassword
@using TacticalHeroes.Admin.Client.Features.Authentication.Login
@using TacticalHeroes.Admin.Client.Features.Authentication.Register
@using TacticalHeroes.Admin.Client.Features.Authentication.ResendConfirmation

<PageTitle>Вход · Tactical Heroes</PageTitle>

<MudPaper Elevation="0" Class="account-panel">
    <div class="account-panel-header">
        <MudText Typo="Typo.overline" Color="Color.Primary">SECURE ACCESS</MudText>
        <MudText Typo="Typo.h4">Добро пожаловать</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary">
            Вход выполняется через OAuth 2.0 / OpenID Connect с PKCE и PAR.
        </MudText>
    </div>

    <MudTabs @bind-ActivePanelIndex="_activeTab"
             Rounded="true"
             ApplyEffectsToContainer="true">
        <MudTabPanel Text="Вход" Icon="@Icons.Material.Filled.Login" Class="account-tab-panel">
            <LoginForm ReturnUrl="@ReturnUrl" Error="@Error" />
        </MudTabPanel>
        <MudTabPanel Text="Регистрация" Icon="@Icons.Material.Filled.PersonAdd" Class="account-tab-panel">
            <RegisterForm />
        </MudTabPanel>
        <MudTabPanel Text="Подтверждение" Icon="@Icons.Material.Filled.MarkEmailRead" Class="account-tab-panel">
            <ResendConfirmationForm />
        </MudTabPanel>
        <MudTabPanel Text="Восстановление" Icon="@Icons.Material.Filled.Key" Class="account-tab-panel">
            <ForgotPasswordForm />
        </MudTabPanel>
    </MudTabs>
</MudPaper>

@code {
    private int _activeTab;

    [SupplyParameterFromQuery(Name = "returnUrl")]
    public string? ReturnUrl { get; set; }

    [SupplyParameterFromQuery(Name = "error")]
    public string? Error { get; set; }

    [SupplyParameterFromQuery(Name = "mode")]
    public string? Mode { get; set; }

    protected override void OnParametersSet()
    {
        _activeTab = Mode?.ToLowerInvariant() switch
        {
            "register" => 1,
            "confirmation" => 2,
            "recover" => 3,
            _ => 0,
        };
    }
}
