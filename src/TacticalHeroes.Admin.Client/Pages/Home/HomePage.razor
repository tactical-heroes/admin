@page "/"

<PageTitle>Главная · Tactical Heroes</PageTitle>

<PageHeader Title="Панель управления"
            Subtitle="Единая точка администрирования Tactical Heroes" />

<MudGrid Spacing="3">
    <MudItem xs="12" md="6">
        <MudCard Class="entity-card" Elevation="0">
            <MudCardContent>
                <div class="entity-card-icon roles">
                    <MudIcon Icon="@Icons.Material.Filled.Security"
                             Size="Size.Large" />
                </div>
                <MudText Typo="Typo.h6" Class="entity-card-title">
                    Роли
                </MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">
                    Управление ролями и назначенными claims.
                </MudText>
            </MudCardContent>
            <MudCardActions>
                <MudButton Href="/roles"
                           Variant="Variant.Text"
                           EndIcon="@Icons.Material.Filled.ArrowForward">
                    Открыть роли
                </MudButton>
            </MudCardActions>
        </MudCard>
    </MudItem>

    <MudItem xs="12" md="6">
        <MudCard Class="entity-card" Elevation="0">
            <MudCardContent>
                <div class="entity-card-icon users">
                    <MudIcon Icon="@Icons.Material.Filled.Group"
                             Size="Size.Large" />
                </div>
                <MudText Typo="Typo.h6" Class="entity-card-title">
                    Пользователи
                </MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">
                    Просмотр аккаунтов, статусов и пользовательских claims.
                </MudText>
            </MudCardContent>
            <MudCardActions>
                <MudButton Href="/users"
                           Variant="Variant.Text"
                           EndIcon="@Icons.Material.Filled.ArrowForward">
                    Открыть пользователей
                </MudButton>
            </MudCardActions>
        </MudCard>
    </MudItem>
</MudGrid>

<MudAlert Severity="Severity.Info"
          Variant="Variant.Outlined"
          Class="auth-note">
    Авторизация пока не подключена. Dev API отвечает 401 на административные методы,
    поэтому экраны покажут данные после реализации входа.
</MudAlert>
