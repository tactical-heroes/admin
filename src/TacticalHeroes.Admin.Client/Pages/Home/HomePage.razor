@attribute [Route(AdminRoutes.Home)]
@attribute [Authorize]

<PageTitle>Главная · @(Branding.GameName)</PageTitle>

<PageHeader Title="Главная"
            Subtitle="@($"Панель администрирования онлайн-игры {Branding.GameName}")" />

<section class="welcome-panel" aria-labelledby="welcome-title">
    <div class="welcome-icon" aria-hidden="true">
        <MudIcon Icon="@Icons.Material.Filled.SportsEsports"
                 Size="Size.Large" />
    </div>
    <div>
        <MudText Typo="Typo.h5" Class="welcome-title" id="welcome-title">
            Добро пожаловать
        </MudText>
        <MudText Typo="Typo.body1" Color="Color.Secondary">
            Здесь собраны инструменты для управления игрой и её развитием.
        </MudText>
    </div>
</section>
