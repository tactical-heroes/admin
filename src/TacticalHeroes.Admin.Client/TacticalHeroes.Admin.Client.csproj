<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

	<PropertyGroup>
		<NoDefaultLaunchSettingsFile>true</NoDefaultLaunchSettingsFile>
		<StaticWebAssetProjectMode>Default</StaticWebAssetProjectMode>
		<BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
		<MetricsSupport>true</MetricsSupport>
		<EventSourceSupport>true</EventSourceSupport>
		<HttpActivityPropagationSupport>true</HttpActivityPropagationSupport>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" />
		<PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.Authentication" />
		<PackageReference Include="MudBlazor" />
		<PackageReference Include="PANiXiDA.Core.Observability.WebAssembly" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Modules\TacticalHeroes.Admin.Modules.Compendium\TacticalHeroes.Admin.Modules.Compendium.csproj" />
		<ProjectReference Include="..\Modules\TacticalHeroes.Admin.Modules.Identity\TacticalHeroes.Admin.Modules.Identity.csproj" />
		<ProjectReference Include="..\TacticalHeroes.Admin.Api\TacticalHeroes.Admin.Api.csproj" />
		<ProjectReference Include="..\TacticalHeroes.Admin.Shared\TacticalHeroes.Admin.Shared.csproj" />
	</ItemGroup>

  <ItemGroup>
    <Using Include="TacticalHeroes.Admin.Shared.Navigation" />
  </ItemGroup>

</Project>
