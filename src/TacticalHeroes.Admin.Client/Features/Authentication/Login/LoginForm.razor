@if (!string.IsNullOrWhiteSpace(ErrorMessage))
{
    <div class="auth-feedback auth-feedback--error auth-feedback--login" role="alert">
        @ErrorMessage
    </div>
}

<div class="auth-form">
    <header class="auth-form-header">
        <MudIcon Icon="@Icons.Material.Outlined.Login" Class="auth-state-icon" />
        <h1 class="auth-form-title">Вход в аккаунт</h1>
        <p class="auth-form-copy">Используйте учётную запись Tactical Heroes.</p>
    </header>

    @if (string.IsNullOrWhiteSpace(ReturnUrl))
    {
        <a class="auth-command"
           href="/authentication/challenge?returnUrl=%2F">
            Продолжить вход
            <span aria-hidden="true">→</span>
        </a>
    }
    else
    {
        <form method="post"
              action="/authentication/sign-in"
              class="auth-form">
            <AntiforgeryToken />
            <input type="hidden" name="ReturnUrl" value="@ReturnUrl" />

            <div class="auth-field">
                <label for="login-email">Email</label>
                <span class="auth-input-shell">
                    <MudIcon Icon="@Icons.Material.Outlined.Email" Class="auth-field-icon" />
                    <input class="auth-input"
                           id="login-email"
                           type="email"
                           name="Email"
                           autocomplete="username"
                           inputmode="email"
                           placeholder="Введите email"
                           required />
                </span>
            </div>

            <div class="auth-field">
                <label for="login-password">Пароль</label>
                <span class="auth-input-shell">
                    <MudIcon Icon="@Icons.Material.Outlined.Lock" Class="auth-field-icon" />
                    <input class="auth-input"
                           id="login-password"
                           type="@(_showPassword ? "text" : "password")"
                           name="Password"
                           autocomplete="current-password"
                           placeholder="Введите пароль"
                           required />
                    <button class="auth-password-toggle"
                            type="button"
                            aria-label="@(_showPassword ? "Скрыть пароль" : "Показать пароль")"
                            @onclick="TogglePasswordVisibility">
                        <MudIcon Icon="@(_showPassword ? Icons.Material.Outlined.VisibilityOff : Icons.Material.Outlined.Visibility)" />
                    </button>
                </span>
            </div>

            <div class="auth-option-row">
                <a class="auth-link" href="@BuildModeHref("recover")">Забыли пароль?</a>
            </div>

            <button type="submit" class="auth-command">
                Войти
                <span aria-hidden="true">→</span>
            </button>
        </form>
    }

    <div class="auth-form-footer">
        <p>
            Нет аккаунта?
            <a class="auth-link" href="@BuildModeHref("register")">Зарегистрироваться</a>
        </p>
        <p class="auth-form-footer-secondary">
            Не пришло письмо?
            <a class="auth-link" href="@BuildModeHref("confirmation")">Отправить повторно</a>
        </p>
    </div>
</div>

@code {
    private bool _showPassword;

    [Parameter]
    public string? ReturnUrl { get; set; }

    [Parameter]
    public string? Error { get; set; }

    private string? ErrorMessage => Error switch
    {
        "invalid_credentials" => "Неверный email или пароль.",
        "forbidden" => "Аккаунт не подтверждён, заблокирован или временно заблокирован после неудачных попыток.",
        "invalid_request" => "Ссылка входа устарела или повреждена. Начните вход заново.",
        "unavailable" => "Сервис авторизации временно недоступен. Повторите попытку позже.",
        "oauth" => "OAuth-вход не удалось завершить. Начните его заново.",
        _ => null,
    };

    private void TogglePasswordVisibility()
    {
        _showPassword = !_showPassword;
    }

    private string BuildModeHref(string mode)
    {
        return string.IsNullOrWhiteSpace(ReturnUrl)
            ? $"/login?mode={mode}"
            : $"/login?mode={mode}&returnUrl={Uri.EscapeDataString(ReturnUrl)}";
    }
}
