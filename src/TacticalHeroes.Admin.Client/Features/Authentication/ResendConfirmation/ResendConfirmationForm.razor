@using System.ComponentModel.DataAnnotations
@using TacticalHeroes.Admin.Client.Entities.Authentication.Api
@using TacticalHeroes.Admin.Client.Shared.Api
@inject AuthenticationApi AuthenticationApi

@if (_requested)
{
    <div class="auth-form">
        <header class="auth-form-header">
            <MudIcon Icon="@Icons.Material.Outlined.MarkEmailRead" Class="auth-state-icon" />
            <h1 class="auth-form-title">Проверьте почту</h1>
            <p class="auth-form-copy">
                Если аккаунт существует и ещё не подтверждён, новое письмо уже отправлено.
            </p>
        </header>
        <div class="auth-feedback auth-feedback--success" role="status">
            Мы используем одинаковый ответ для всех адресов и не раскрываем наличие аккаунта.
        </div>
        <a class="auth-command" href="/login">Вернуться ко входу</a>
    </div>
}
else
{
    <EditForm Model="_model"
              OnValidSubmit="SubmitAsync"
              FormName="resend-confirmation"
              class="auth-form">
        <DataAnnotationsValidator />

        <header class="auth-form-header">
            <MudIcon Icon="@Icons.Material.Outlined.MarkEmailUnread" Class="auth-state-icon" />
            <h1 class="auth-form-title">Подтверждение email</h1>
            <p class="auth-form-copy">
                Запросите новое письмо, если предыдущая ссылка не пришла или уже истекла.
            </p>
        </header>

        @if (!string.IsNullOrWhiteSpace(_error))
        {
            <div class="auth-feedback auth-feedback--error" role="alert">@_error</div>
        }

        <div class="auth-field">
            <label for="confirmation-email">Email</label>
            <span class="auth-input-shell">
                <MudIcon Icon="@Icons.Material.Outlined.Email" Class="auth-field-icon" />
                <InputText class="auth-input"
                           id="confirmation-email"
                           @bind-Value="_model.Email"
                           type="email"
                           inputmode="email"
                           autocomplete="email"
                           placeholder="Введите email"
                           disabled="@_submitting" />
            </span>
            <ValidationMessage For="@(() => _model.Email)" />
        </div>

        <button type="submit" class="auth-command" disabled="@_submitting">
            @(_submitting ? "Отправляем…" : "Отправить повторно")
        </button>
    </EditForm>
}

@code {
    private readonly EmailModel _model = new();
    private bool _submitting;
    private bool _requested;
    private string? _error;

    private async Task SubmitAsync()
    {
        _submitting = true;
        _error = null;

        try
        {
            await AuthenticationApi.ResendConfirmationEmailAsync(_model.Email);
            _requested = true;
        }
        catch (Exception exception)
        {
            _error = ApiErrorMessage.FromException(exception);
        }
        finally
        {
            _submitting = false;
        }
    }

    private sealed class EmailModel
    {
        [Required(ErrorMessage = "Укажите email.")]
        [EmailAddress(ErrorMessage = "Укажите корректный email.")]
        public string Email { get; set; } = string.Empty;
    }
}
