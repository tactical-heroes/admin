@using System.ComponentModel.DataAnnotations
@using TacticalHeroes.Admin.Client.Entities.Authentication.Api
@using TacticalHeroes.Admin.Client.Shared.Api
@inject AuthenticationApi AuthenticationApi

@if (!UserId.HasValue || string.IsNullOrWhiteSpace(PasswordResetToken))
{
    <MudAlert Severity="Severity.Error" Variant="Variant.Outlined">
        Ссылка восстановления неполная или повреждена.
    </MudAlert>
}
else if (_completed)
{
    <MudAlert Severity="Severity.Success" Variant="Variant.Outlined" Class="account-alert">
        Пароль изменён. Теперь можно войти с новым паролем.
    </MudAlert>
    <MudButton Href="/authentication/challenge?returnUrl=%2F"
               Variant="Variant.Filled"
               Color="Color.Primary"
               FullWidth="true">
        Перейти ко входу
    </MudButton>
}
else
{
    @if (!string.IsNullOrWhiteSpace(_error))
    {
        <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="account-alert">
            @_error
        </MudAlert>
    }

    <EditForm Model="_model" OnValidSubmit="SubmitAsync" FormName="reset-password">
        <DataAnnotationsValidator />
        <MudStack Spacing="3">
            <MudTextField @bind-Value="_model.Password"
                          For="@(() => _model.Password)"
                          Label="Новый пароль"
                          InputType="InputType.Password"
                          Variant="Variant.Outlined"
                          HelperText="Минимум 8 символов: верхний и нижний регистр, цифра и специальный символ"
                          Disabled="_submitting" />
            <MudTextField @bind-Value="_model.PasswordConfirmation"
                          For="@(() => _model.PasswordConfirmation)"
                          Label="Повторите новый пароль"
                          InputType="InputType.Password"
                          Variant="Variant.Outlined"
                          Disabled="_submitting" />
            <MudButton ButtonType="ButtonType.Submit"
                       Variant="Variant.Filled"
                       Color="Color.Primary"
                       Size="Size.Large"
                       FullWidth="true"
                       Disabled="_submitting">
                Сохранить новый пароль
            </MudButton>
        </MudStack>
    </EditForm>
}

@code {
    private readonly ResetModel _model = new();
    private bool _submitting;
    private bool _completed;
    private string? _error;

    [Parameter]
    public Guid? UserId { get; set; }

    [Parameter]
    public string? PasswordResetToken { get; set; }

    private async Task SubmitAsync()
    {
        if (!UserId.HasValue || string.IsNullOrWhiteSpace(PasswordResetToken))
        {
            return;
        }

        _submitting = true;
        _error = null;

        try
        {
            await AuthenticationApi.ResetPasswordAsync(
                UserId.Value,
                PasswordResetToken,
                _model.Password);
            _completed = true;
        }
        catch (Exception exception)
        {
            _error = ApiErrorMessage.FromException(exception);
        }
        finally
        {
            _submitting = false;
        }
    }

    private sealed class ResetModel
    {
        [Required(ErrorMessage = "Укажите новый пароль.")]
        [MinLength(8, ErrorMessage = "Пароль должен содержать минимум 8 символов.")]
        public string Password { get; set; } = string.Empty;

        [Required(ErrorMessage = "Повторите новый пароль.")]
        [Compare(nameof(Password), ErrorMessage = "Пароли не совпадают.")]
        public string PasswordConfirmation { get; set; } = string.Empty;
    }
}
