@using TacticalHeroes.Admin.Client.Entities.Users.Model

<MudForm @ref="_form"
         @bind-IsValid="_isValid">
    <MudPaper Elevation="0" Class="edit-section">
        <MudText Typo="Typo.h6" Class="section-title">
            Аккаунт
        </MudText>
        <MudGrid Spacing="2">
            <MudItem xs="12" md="6">
                <MudTextField T="string"
                              @bind-Value="Model.Email"
                              Label="Email"
                              InputType="InputType.Email"
                              Variant="Variant.Outlined"
                              Required="true"
                              RequiredError="Укажите email" />
            </MudItem>
            <MudItem xs="12" md="6">
                <MudTextField T="string"
                              @bind-Value="Model.UserName"
                              Label="Имя пользователя"
                              Variant="Variant.Outlined"
                              Required="true"
                              RequiredError="Укажите имя пользователя" />
            </MudItem>
            <MudItem xs="12" md="6">
                <MudSelect T="string"
                           @bind-Value="Model.Status"
                           ToStringFunc="@GetStatusDisplayName"
                           Label="Статус"
                           Variant="Variant.Outlined"
                           Required="true"
                           RequiredError="Выберите статус">
                    @foreach (var status in Statuses)
                    {
                        <MudSelectItem T="string" Value="@status.Name">
                            @status.DisplayName
                        </MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" md="6" Class="confirmed-field">
                <MudSwitch T="bool"
                           @bind-Value="Model.IsConfirmed"
                           Color="Color.Success"
                           Label="Email подтверждён" />
            </MudItem>
        </MudGrid>
    </MudPaper>

    <MudPaper Elevation="0" Class="edit-section">
        <ClaimsEditor Claims="Model.Claims" />
    </MudPaper>

    <div class="form-actions">
        <MudButton Href="/users"
                   Variant="Variant.Text"
                   Disabled="Saving">
            Отмена
        </MudButton>
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Save"
                   Disabled="Saving"
                   OnClick="SubmitAsync">
            @if (Saving)
            {
                <MudProgressCircular Size="Size.Small"
                                     Indeterminate="true"
                                     Class="button-progress" />
            }
            Сохранить
        </MudButton>
    </div>
</MudForm>

@code {
    private MudForm? _form;
    private bool _isValid;

    [Parameter, EditorRequired]
    public UserDetails Model { get; set; } = new();

    [Parameter, EditorRequired]
    public IReadOnlyList<UserStatus> Statuses { get; set; } = [];

    [Parameter]
    public bool Saving { get; set; }

    [Parameter]
    public EventCallback OnSave { get; set; }

    private string GetStatusDisplayName(string? statusName)
    {
        return Statuses.FirstOrDefault(status => status.Name == statusName)?.DisplayName
            ?? statusName
            ?? string.Empty;
    }

    private async Task SubmitAsync()
    {
        if (_form is null)
        {
            return;
        }

        await _form.ValidateAsync();

        if (_isValid)
        {
            await OnSave.InvokeAsync();
        }
    }
}
