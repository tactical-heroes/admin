<nav class="nav-shell" aria-label="Основная навигация">
<MudNavMenu>
    <MudText Typo="Typo.overline"
             Class="nav-section-title">
        Обзор
    </MudText>
    <MudNavLink Href="/"
                Match="NavLinkMatch.All"
                Icon="@Icons.Material.Filled.SpaceDashboard">
        Главная
    </MudNavLink>

    @foreach (var group in AdminModules.NavigationGroups)
    {
        <MudText Typo="Typo.overline"
                 Class="nav-section-title nav-section-spaced">
            @group.Title
        </MudText>
        @foreach (var item in group.Items)
        {
            <MudNavLink Href="@item.Href"
                        Match="NavLinkMatch.Prefix"
                        Icon="@item.Icon">
                @item.Label
            </MudNavLink>
        }
    }
</MudNavMenu>
</nav>
