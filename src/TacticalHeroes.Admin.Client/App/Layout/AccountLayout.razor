@inherits LayoutComponentBase

<MudThemeProvider Theme="@AppTheme.Current" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<main class="account-layout">
    <section class="account-visual" aria-hidden="true">
        <div class="account-brand">
            <img class="account-brand-mark"
                 src="logo.png"
                 alt="" />
            <div>
                <MudText Typo="Typo.h5">Tactical Heroes</MudText>
                <MudText Typo="Typo.body2">Control room</MudText>
            </div>
        </div>
        <div class="account-visual-copy">
            <MudText Typo="Typo.h2">Управление без лишнего шума.</MudText>
            <MudText Typo="Typo.h6">
                Роли, пользователи и доступы в одной защищённой панели.
            </MudText>
        </div>
        <div class="account-grid"></div>
    </section>
    <section class="account-content">
        @Body
    </section>
</main>

<div id="blazor-error-ui" data-nosnippet>
    Произошла непредвиденная ошибка.
    <a href="." class="reload">Перезагрузить</a>
    <button type="button" class="dismiss">×</button>
</div>
