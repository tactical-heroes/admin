<Project Sdk="Microsoft.NET.Sdk" InitialTargets="PrepareTacticalHeroesApiClientForDesignTime">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RepositoryRoot>$(MSBuildProjectDirectory)\..\..</RepositoryRoot>
    <KiotaOpenApiFile>$(RepositoryRoot)\openapi\tactical-heroes.json</KiotaOpenApiFile>
    <KiotaGeneratedDir>$(MSBuildProjectDirectory)\obj\$(Configuration)\$(TargetFramework)\Generated</KiotaGeneratedDir>
    <KiotaGeneratedClientFile>$(KiotaGeneratedDir)\TacticalHeroesApiClient.cs</KiotaGeneratedClientFile>
    <KiotaToolDll>$(NuGetPackageRoot)/microsoft.openapi.kiota/1.34.1/tools/net10.0/any/kiota.dll</KiotaToolDll>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Kiota.Bundle" Version="2.0.0" />
  </ItemGroup>

  <Target Name="GenerateTacticalHeroesApiClient"
          BeforeTargets="CoreCompile"
          Condition="'$(BuildingInsideVisualStudio)' != 'true' or '$(DesignTimeBuild)' != 'true'"
          Inputs="$(KiotaOpenApiFile);$(MSBuildProjectFullPath);$(RepositoryRoot)\dotnet-tools.json"
          Outputs="$(KiotaGeneratedClientFile)">
    <Exec Command="dotnet tool restore"
          WorkingDirectory="$(RepositoryRoot)" />
    <Exec Command="dotnet &quot;$(KiotaToolDll)&quot; generate --language CSharp --openapi &quot;$(KiotaOpenApiFile)&quot; --output &quot;$(KiotaGeneratedDir)&quot; --class-name TacticalHeroesApiClient --namespace-name TacticalHeroes.Admin.Api.Generated --clean-output --exclude-backward-compatible --include-path &quot;/api/v1/roles&quot; --include-path &quot;/api/v1/roles/**&quot; --include-path &quot;/api/v1/users&quot; --include-path &quot;/api/v1/users/**&quot; --log-level Error"
          WorkingDirectory="$(RepositoryRoot)" />
  </Target>

  <Target Name="PrepareTacticalHeroesApiClientForDesignTime"
          Condition="'$(DesignTimeBuild)' == 'true' and '$(BuildingInsideVisualStudio)' != 'true'"
          DependsOnTargets="AddGeneratedTacticalHeroesApiClient" />

  <Target Name="AddGeneratedTacticalHeroesApiClient"
          BeforeTargets="CoreCompile"
          DependsOnTargets="GenerateTacticalHeroesApiClient">
    <ItemGroup>
      <Compile Include="$(KiotaGeneratedDir)\**\*.cs" />
    </ItemGroup>
  </Target>

</Project>
