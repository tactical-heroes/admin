<header class="page-header">
    <div>
        <MudText Typo="Typo.h4"
                 HtmlTag="h1"
                 Class="page-title">
            @Title
        </MudText>
        @if (!string.IsNullOrWhiteSpace(Subtitle))
        {
            <MudText Typo="Typo.body2"
                     Color="Color.Secondary"
                     Class="page-subtitle">
                @Subtitle
            </MudText>
        }
    </div>

    @if (Actions is not null)
    {
        <div class="page-actions">
            @Actions
        </div>
    }
</header>
