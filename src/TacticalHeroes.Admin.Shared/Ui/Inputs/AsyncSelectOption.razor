@typeparam TId where TId : notnull
@typeparam TOption where TOption : SelectOption<TId>
@inherits CancelableComponentBase

<LoadableContent Loading="IsLoading"
                 LoadError="@LoadError"
                 OnRetry="LoadAsync"
                 LoadingHeight="56px">
    <ChildContent>
        <MudAutocomplete @ref="_autocomplete"
                         T="TId"
                         Value="@(MultiSelection ? default : Value)"
                         ValueChanged="SetValueAsync"
                         For="@(MultiSelection ? null : For)"
                         Label="@Label"
                         Variant="Variant.Outlined"
                         ToStringFunc="GetName"
                         SearchFunc="SearchAsync"
                         DebounceInterval="DebounceInterval"
                         MinCharacters="0"
                         HelperText="@($"Для поиска введите минимум {MinCharacters} символа")"
                         MaxItems="MaxItems"
                         MaxLength="MaxLength"
                         Strict="false"
                         Clearable="true"
                         OnClearButtonClick="@(() => _autocomplete?.OpenMenuAsync() ?? Task.CompletedTask)"
                         ResetValueOnEmptyText="true"
                         ShowProgressIndicator="true"
                         Error="Error"
                         ErrorText="@ErrorText">
            <NoItemsTemplate>
                @if (SearchError is null && !IsSearchTooShort)
                {
                    <MudText Class="px-4 py-2">@EmptyText</MudText>
                    @if (CreateHref is not null)
                    {
                        <MudLink Href="@CreateHref" Class="px-4">@CreateText</MudLink>
                    }
                }
            </NoItemsTemplate>
        </MudAutocomplete>
        @if (MultiSelection)
        {
            <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="1" Class="mt-2">
                @foreach (var id in Values.Distinct())
                {
                    <MudChip @key="id" T="TId" Value="id" OnClose="RemoveValueAsync"
                             Color="Color.Primary" Variant="Variant.Outlined">
                        @GetSelectedName(id)
                    </MudChip>
                }
            </MudStack>
        }
        @if (SearchError is not null)
        {
            <MudAlert Severity="Severity.Error" Class="mt-2">@SearchError</MudAlert>
        }
    </ChildContent>
</LoadableContent>
