@typeparam TId where TId : notnull
@typeparam TOption where TOption : SelectOption<TId>
@inherits CancelableComponentBase

<LoadableContent Loading="IsLoading"
                 LoadError="@LoadError"
                 OnRetry="LoadAsync"
                 LoadingHeight="56px">
    <ChildContent>
        @if (MultiSelection)
        {
            <MudSelect T="TId"
                       Label="@Label"
                       Variant="Variant.Outlined"
                       MultiSelection="true"
                       ToStringFunc="GetSelectedName"
                       SelectedValues="Values"
                       SelectedValuesChanged="SetValuesAsync"
                       Error="Error"
                       ErrorText="@ErrorText"
                       HelperText="@HelperText">
                @foreach (var option in Items ?? [])
                {
                    <MudSelectItem T="TId" Value="@option.Id">@GetOptionName(option)</MudSelectItem>
                }
                @foreach (var id in Values.Distinct().Where(id => Items?.All(option => !EqualityComparer<TId>.Default.Equals(option.Id, id)) != false))
                {
                    <MudSelectItem T="TId" Value="@id">@GetSelectedName(id)</MudSelectItem>
                }
            </MudSelect>
        }
        else
        {
            <MudAutocomplete @ref="_autocomplete"
                             T="TId"
                             Value="@Value"
                             ValueChanged="SetValueAsync"
                             For="For"
                             Label="@Label"
                             Variant="Variant.Outlined"
                             ToStringFunc="GetName"
                             SearchFunc="SearchAsync"
                             DebounceInterval="DebounceInterval"
                             MinCharacters="0"
                             HelperText="@(HelperText ?? $"Для поиска введите минимум {MinCharacters} символа")"
                             MaxItems="MaxItems"
                             MaxLength="MaxLength"
                             Strict="false"
                             Clearable="true"
                             OnClearButtonClick="@(() => _autocomplete?.OpenMenuAsync() ?? Task.CompletedTask)"
                             ResetValueOnEmptyText="true"
                             ShowProgressIndicator="true"
                             Error="Error"
                             ErrorText="@ErrorText">
                <NoItemsTemplate>
                    @if (SearchError is null && !IsSearchTooShort)
                    {
                        <MudText Class="px-4 py-2">@EmptyText</MudText>
                        @if (CreateHref is not null)
                        {
                            <MudLink Href="@CreateHref" Class="px-4">@CreateText</MudLink>
                        }
                    }
                </NoItemsTemplate>
            </MudAutocomplete>
            @if (SearchError is not null)
            {
                <MudAlert Severity="Severity.Error" Class="mt-2">@SearchError</MudAlert>
            }
        }
    </ChildContent>
</LoadableContent>
