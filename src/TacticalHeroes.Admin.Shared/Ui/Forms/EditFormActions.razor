<div class="form-actions">
    <MudButton Href="@CancelHref"
               Variant="Variant.Text"
               Disabled="Busy">
        Отмена
    </MudButton>
    @if (SubmitPermission is null)
    {
        <AsyncActionButton Class="submit-action"
                           Text="@ActionText"
                           Busy="Busy"
                           StartIcon="@ActionIcon"
                           OnClick="OnSubmit" />
    }
    else
    {
        <PermissionView Permissions="[SubmitPermission]">
            <AsyncActionButton Class="submit-action"
                               Text="@ActionText"
                               Busy="Busy"
                               StartIcon="@ActionIcon"
                               OnClick="OnSubmit" />
        </PermissionView>
    }
</div>
