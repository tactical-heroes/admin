<div class="form-actions">
    <MudButton Href="@CancelHref"
               Variant="Variant.Text"
               Disabled="Busy">
        Отмена
    </MudButton>
    @if (ChildContent is not null)
    {
        @ChildContent
    }
    else
    {
        <AsyncActionButton Class="submit-action"
                           Text="@ActionText"
                           Busy="Busy"
                           StartIcon="@ActionIcon"
                           OnClick="OnSubmit" />
    }
</div>
