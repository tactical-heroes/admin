<div class="row-actions">
    <MudIconButton Icon="@Icons.Material.Outlined.Edit"
                   Href="@EditHref"
                   Color="Color.Primary"
                   Size="Size.Small"
                   Disabled="Disabled"
                   aria-label="@EditLabel" />
    <MudIconButton Icon="@Icons.Material.Outlined.Delete"
                   Color="Color.Error"
                   Size="Size.Small"
                   Disabled="Disabled"
                   OnClick="OnDelete"
                   aria-label="@DeleteLabel" />
</div>
